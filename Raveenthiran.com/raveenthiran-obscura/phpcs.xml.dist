<?xml version="1.0"?>
<ruleset name="Obscura">
  <description>WordPress coding standards for the Obscura theme (advisory).</description>
  <file>.</file>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/assets/js/webgl-hero.js</exclude-pattern>
  <arg name="extensions" value="php"/>
  <arg value="ps"/>
  <!-- Requires: composer global require wp-coding-standards/wpcs (+ phpstan optional) -->
  <rule ref="WordPress-Extra">
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="Generic.Arrays.DisallowShortArraySyntax"/>
  </rule>
  <config name="testVersion" value="7.4-"/>
</ruleset>
