---
export interface Props { active?: string }
const { active = '' } = Astro.props;
const items = [
	{ key: 'work',    label: 'Work',    href: '/work/' },
	{ key: 'studio',  label: 'Studio',  href: '/about/' },
	{ key: 'enquire', label: 'Enquire', href: '/enquire/' },
];
---
<nav id="dock" aria-label="Primary">
	{items.map((it) => (
		<a href={it.href} data-key={it.key} class={active === it.key ? 'active' : ''}>{it.label}</a>
	))}
</nav>
