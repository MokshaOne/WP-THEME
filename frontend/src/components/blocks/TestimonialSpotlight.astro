---
import type { TestimonialBlock, Site } from '../../lib/wp';
interface Props { block: TestimonialBlock; site: Site; }
const { block, site } = Astro.props;
// Fall back to the first Home testimonial when the block's own quote is blank.
const fb = site.home.testimonials[0];
const quote = block.quote || (fb ? fb.text : '');
const by = block.by || (fb ? fb.by : '');
const role = block.role;
---
{quote && (
	<section class="sec blk blk-testimonial" data-reveal>
		<div class="ts-spot">
			<div class="ts-spot__body">
				<div class="ts-spot__mark" aria-hidden="true">&ldquo;</div>
				<p class="ts-spot__quote">{quote}</p>
				<div class="ts-spot__by">
					<span>{by}</span>
					{role && <span class="k">{role}</span>}
				</div>
			</div>
			<div class="ts-spot__img">
				{block.image
					? <img src={block.image} alt={by} loading="lazy" />
					: <span class="k ts-spot__ph">Client portrait</span>}
			</div>
		</div>
	</section>
)}
