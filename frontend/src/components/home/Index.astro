---
import type { Site, Project } from '../../lib/wp';
interface Props { site: Site; projects: Project[]; }
const { site, projects } = Astro.props;
const up = (s: string) => (s || '').toUpperCase();
const num = (n: number) => String(n).padStart(3, '0');
const frames = projects.slice(0, 10);
const seriesCount = new Set(projects.flatMap((p) => (p.series || []).map((s) => s.slug))).size || projects.length;
const years = projects.map((p) => +p.year).filter(Boolean);
const from = years.length ? Math.min(...years) : 2020;
const to = years.length ? Math.max(...years) : new Date().getFullYear();
---
<section class="hv-idx">
	<div class="hv-idx__head" data-intro>
		<h1 class="hv-idx__h1">An index of people, light and Vienna —<br /><em class="hv-serif">photographed slowly.</em></h1>
		<div class="chrome" style="text-align:right">ARCHIVE {from} — {to}<br />{seriesCount} SERIES · {projects.length} PROJECTS</div>
	</div>
	<div class="rail" data-drag>
		{frames.map((p, i) => (
			<a class="card" href={`/work/${p.slug}/`}>
				<div class="plate"><img src={p.image} alt={p.title} loading="lazy" /></div>
				<div class="cap"><span class="n">{num(i + 1)}</span><span>{up(p.title)}</span></div>
			</a>
		))}
	</div>
	<div class="wrap" style="padding-top:26px;font-size:11px;letter-spacing:0.2em;color:var(--faint)">SCROLL SIDEWAYS ——→</div>
</section>

<!-- THE INDEX -->
<section class="sec" style="border-top:1px solid var(--line);padding-top:70px">
	<div class="sec__head" data-reveal>
		<h2 data-letters>THE INDEX</h2>
		<div class="sec__hint">HOVER A NAME — CLICK TO OPEN</div>
	</div>
	<div class="index">
		{projects.map((p, i) => (
			<a class="index__row" href={`/work/${p.slug}/`} data-peek data-img={p.image}>
				<span class="k">{num(i + 1)}</span>
				<span class="t">{up(p.title)}</span>
				<span class="k cat">{up(p.category)}</span>
				<span class="k year">{p.year}</span>
			</a>
		))}
	</div>
</section>

<a class="cta cta--sm" href="/enquire/"><span>YOUR SESSION IS NEXT</span><span>→</span></a>
