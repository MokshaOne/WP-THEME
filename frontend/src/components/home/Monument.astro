---
import type { Site, Project } from '../../lib/wp';
interface Props { site: Site; projects: Project[]; }
const { site, projects } = Astro.props;
const up = (s: string) => (s || '').toUpperCase();
const featured = (projects.filter((p) => p.featured_home).length ? projects.filter((p) => p.featured_home) : projects);
const hero = featured[0] || projects[0];
const grid = projects.filter((p) => p.slug !== hero?.slug).slice(0, 3);
const tagline = 'The quiet drama of a single frame.';
const marqueeWords = (site.home.marquee || 'SELECTED WORK · VIENNA · PORTRAIT · FASHION · EDITORIAL · ').trim() + ' ';
---
<section>
	<svg class="hv-mon__wm" viewBox="0 0 1000 108" aria-label="Raveenthiran">
		<text x="0" y="92" textLength="1000" lengthAdjust="spacingAndGlyphs" font-size="118">RAVEENTHIRAN</text>
	</svg>
	<div class="hv-mon__meta">
		<span>PORTRAIT &amp; FASHION PHOTOGRAPHY</span>
		<span>{up(site.contact.location) || 'VIENNA, AT'}</span>
		<span>EST. MMXX</span>
	</div>
	{hero && (
		<a class="hv-mon__hero" href={`/work/${hero.slug}/`} data-intro>
			<img src={hero.image} alt={hero.title} />
			<div class="hv-mon__tag">{tagline}</div>
			<div class="hv-mon__fig">{up(hero.title)}<br /><span class="chrome" style="color:var(--dim)">FIG. 001</span></div>
		</a>
	)}
</section>

<div class="marquee" data-skew aria-hidden="true">
	<div class="marquee__row marquee__row--a hv-serif" style="font-size:clamp(28px,4vw,52px)"><span>{marqueeWords.repeat(3)}</span><span>{marqueeWords.repeat(3)}</span></div>
</div>

<section>
	<div class="sec__head" style="padding-top:40px" data-reveal>
		<h2 class="hv-serif" style="font-family:var(--font-serif);font-style:italic;font-size:40px">Selected work</h2>
		<a class="sec__hint" href="/work/" style="border-bottom:1px solid var(--ink);color:var(--ink);padding-bottom:3px">FULL INDEX →</a>
	</div>
	<div class="hv-mon__grid">
		{grid.map((p, i) => (
			<a class="card" href={`/work/${p.slug}/`}>
				<div class="plate"><img src={p.image} alt={p.title} loading="lazy" /></div>
				<div class="cap" style="justify-content:space-between"><span>{up(p.title)}</span><span class="c">{String(i + 2).padStart(3, '0')}</span></div>
			</a>
		))}
	</div>
</section>

<a class="cta cta--sm" href="/enquire/"><span>BOOK THE NEXT SHOOT</span><span>→</span></a>
