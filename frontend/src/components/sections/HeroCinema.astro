---
import type { Project } from '../../lib/wp';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
const up = (s: string) => (s || '').toUpperCase();
const featured = (projects.filter((p) => p.featured_home).length ? projects.filter((p) => p.featured_home) : projects).slice(0, 6);
---
<section class="hv-cin" data-cinema>
	{featured.map((p, i) => (
		<img class:list={['hv-cin__img', i === 0 && 'on']} src={p.image} srcset={p.imageSrcset || undefined} sizes="100vw" width={p.imageW || undefined} height={p.imageH || undefined} alt={p.title}
			data-kicker={up(p.category || 'Portrait')} data-title={p.title} style={`object-position:${p.focal}`} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
	))}
	<div class="hv-cin__grad"></div>
	<div class="hv-cin__cap">
		<div class="hv-cin__kicker" data-cin-kicker>{up(featured[0]?.category || '')}</div>
		<div class="hv-cin__title" data-cin-title>{featured[0]?.title}</div>
	</div>
	<div class="hv-cin__nav">
		<button class="rbtn" data-cin-prev aria-label="Previous">←</button>
		<div class="slide-count"><span data-cin-count>01</span><span class="of"> / {String(featured.length).padStart(2, '0')}</span></div>
		<button class="rbtn" data-cin-next aria-label="Next">→</button>
	</div>
</section>
