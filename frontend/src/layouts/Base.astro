---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/montserrat';
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/400-italic.css';
import '@fontsource/roboto/700.css';
import '@fontsource/mr-de-haviland';
import '../styles/theme.css';
import { ClientRouter } from 'astro:transitions';
import { getSite, getProjects } from '../lib/wp';

export interface Props {
	title: string;
	description?: string;
	active?: string;
	ogImage?: string;
}
const { title, description = '', active = '', ogImage = '' } = Astro.props;

const site = await getSite();
const projects = await getProjects();
const albums = Array.from(new Set(projects.map((p) => p.category).filter(Boolean))).sort();
const recent = projects.slice(0, 3);
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const igHandle = site.contact.instagram
	? '@' + site.contact.instagram.replace(/\/+$/, '').split('/').pop()
	: '';
const year = new Date().getFullYear();

const nav = [
	{ key: 'work', label: 'Work', href: '/work/' },
	{ key: 'studio', label: 'Studio', href: '/about/' },
	{ key: 'enquire', label: 'Enquire', href: '/enquire/' },
];

const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' fill='%23ffffff'/%3E%3Ccircle cx='24' cy='24' r='17' fill='none' stroke='%23d7b065' stroke-width='2'/%3E%3Cpath d='M7 24h34M24 7v17' stroke='%23d7b065' stroke-width='2'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<meta property="og:title" content={title} />
	{description && <meta property="og:description" content={description} />}
	{ogImage && <meta property="og:image" content={ogImage} />}
	<meta name="theme-color" content="#ffffff" />
	<link rel="icon" href={favicon} />
	<script is:inline>
		try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
	</script>
	<ClientRouter />
</head>
<body>
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="progress" data-progress></div>

	<!-- full-screen overlay menu -->
	<div class="ovl" data-ovl aria-hidden="true">
		<div class="ovl__inner">
			<p class="ovl__welcome">A photography practice in Vienna — read the <a href="/about/">studio</a> or <a href="/enquire/">start a project</a>.</p>
			<nav class="ovl__nav" aria-label="Primary">
				{nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
			</nav>
			{albums.length > 0 && (
				<p class="ovl__albums">
					{albums.map((a) => <a href={`/work/#${slugify(a)}`}>{a}</a>)}
				</p>
			)}
		</div>
	</div>

	<header class="site-header">
		<a class="monogram" href="/" aria-label="Raveenthiran — home">
			<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 24h38M24 5v19" stroke="currentColor" stroke-width="1.4"/></svg>
		</a>
		<button class="toggle" data-ovl-toggle aria-label="Menu" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
		<button class="theme-toggle" data-theme-toggle aria-label="Toggle light / dark">
			<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
			<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
		</button>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="site-footer">
		<a class="monogram monogram--foot" href="/" aria-label="Raveenthiran — home">
			<svg viewBox="0 0 48 48" aria-hidden="true"><circle cx="24" cy="24" r="19" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M5 24h38M24 5v19" stroke="currentColor" stroke-width="1.4"/></svg>
		</a>
		<span class="foot__rule" aria-hidden="true"></span>
		<a class="foot__email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
		<p class="foot__sub">or <a href="/enquire/">start an enquiry</a> — a firm quote within 24 hours.</p>

		<div class="foot__coords">
			<span>48.2082° N</span><span>16.3738° E</span>
		</div>

		<div class="foot__cols">
			<div class="foot__col">
				<h3>Studio</h3>
				<p>{site.contact.location}</p>
				<p>{site.contact.response}</p>
				<p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
			</div>
			<div class="foot__col">
				<h3>Recent work</h3>
				{recent.map((p) => <p><a href={`/work/${p.slug}/`}>{p.title}</a></p>)}
			</div>
			<div class="foot__col">
				<h3>Albums</h3>
				{albums.map((a) => <p><a href={`/work/#${slugify(a)}`}>{a}</a></p>)}
			</div>
		</div>

		<div class="foot__base">
			<span>© {year} Nishuthan Raveenthiran</span>
			<span class="foot__social">
				{site.contact.instagram && <a href={site.contact.instagram} target="_blank" rel="noopener">Instagram</a>}
				<a href="/work/">Work</a>
				<a href="/enquire/">Enquire</a>
			</span>
		</div>
	</footer>

	<script>
		import '../scripts/ui.js';
	</script>
</body>
</html>
