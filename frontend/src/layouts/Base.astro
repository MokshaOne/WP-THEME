---
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/montserrat';
import '@fontsource/roboto/300.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/400-italic.css';
import '@fontsource/roboto/700.css';
import '@fontsource/mr-de-haviland';
import '../styles/theme.css';
import { ClientRouter } from 'astro:transitions';
import { getSite, getProjects } from '../lib/wp';
import { dict } from '../i18n';

export interface Props {
	title: string;
	description?: string;
	active?: string;
	ogImage?: string;
	preload?: string;
}
const { title, description = '', active = '', ogImage = '', preload = '' } = Astro.props;

const site = await getSite();
const projects = await getProjects();
const albums = Array.from(new Set(projects.map((p) => p.category).filter(Boolean))).sort();
const recent = projects.slice(0, 3);
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

const igHandle = site.contact.instagram
	? '@' + site.contact.instagram.replace(/\/+$/, '').split('/').pop()
	: '';
const year = new Date().getFullYear();
const canonical = new URL(Astro.url.pathname, Astro.site).href;

const nav = [
	{ key: 'work', label: 'Work', href: '/work/' },
	{ key: 'journal', label: 'Journal', href: '/journal/' },
	{ key: 'studio', label: 'Studio', href: '/about/' },
	{ key: 'enquire', label: 'Enquire', href: '/enquire/' },
];

const jsonld = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'ProfessionalService',
			'@id': (Astro.site || '') + '#studio',
			name: 'Raveenthiran Photography',
			image: ogImage || undefined,
			email: site.contact.email,
			url: Astro.site,
			areaServed: 'Europe',
			address: { '@type': 'PostalAddress', addressLocality: 'Vienna', addressCountry: 'AT' },
			geo: { '@type': 'GeoCoordinates', latitude: 48.2082, longitude: 16.3738 },
			founder: { '@type': 'Person', name: 'Nishuthan Raveenthiran', jobTitle: 'Photographer' },
			sameAs: site.contact.instagram ? [site.contact.instagram] : undefined,
		},
		{ '@type': 'WebSite', url: Astro.site, name: 'Raveenthiran', inLanguage: 'en' },
	],
};

const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' fill='%23121110'/%3E%3Ctext x='24' y='35' font-family='Georgia,serif' font-size='36' font-weight='600' fill='%23d7b065' text-anchor='middle'%3ER%3C/text%3E%3C/svg%3E";
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<link rel="canonical" href={canonical} />
	<meta property="og:type" content="website" />
	<meta property="og:site_name" content="Raveenthiran" />
	<meta property="og:title" content={title} />
	<meta property="og:url" content={canonical} />
	{description && <meta property="og:description" content={description} />}
	{ogImage && <meta property="og:image" content={ogImage} />}
	<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
	<meta name="twitter:title" content={title} />
	{description && <meta name="twitter:description" content={description} />}
	{ogImage && <meta name="twitter:image" content={ogImage} />}
	<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
	<meta name="theme-color" content="#121110" media="(prefers-color-scheme: dark)" />
	{preload && <link rel="preload" as="image" href={preload} fetchpriority="high" />}
	<link rel="icon" href={favicon} />
	<script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
	<script id="i18n-data" type="application/json" set:html={JSON.stringify(dict)} is:inline />
	<script is:inline>
		try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
		try { var l = localStorage.getItem('lang'); if (l) document.documentElement.lang = l; } catch (e) {}
		document.documentElement.classList.add('preloading');
	</script>
	<ClientRouter />
</head>
<body>
	<a class="skip-link" href="#main">Skip to content</a>
	<div class="preloader" data-preloader aria-hidden="true">
		<span class="preloader__word">Raveenthiran</span>
	</div>
	<div class="progress" data-progress></div>

	<!-- full-screen cinematic overlay menu -->
	<div class="ovl" data-ovl aria-hidden="true">
		<button class="ovl__close" data-ovl-toggle aria-label="Close menu"><span></span><span></span></button>
		<div class="ovl__inner">
			<p class="ovl__welcome" data-i18n="ovl.welcome">A photography practice in Vienna, working across Europe.</p>
			<nav class="ovl__nav" aria-label="Primary">
				{nav.map((n, i) => (
					<a href={n.href} aria-current={active === n.key ? 'page' : undefined}><span class="ovl__num">0{i + 1}</span><span data-i18n={`nav.${n.key}`}>{n.label}</span></a>
				))}
			</nav>
			{albums.length > 0 && (
				<div class="ovl__albums">
					<span class="ovl__albums-k" data-i18n="ovl.albums">Albums</span>
					<p>{albums.map((a) => <a href={`/work/#${slugify(a)}`}>{a}</a>)}</p>
				</div>
			)}
			<div class="ovl__foot">
				<a class="ovl__email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
				{site.contact.instagram && <a href={site.contact.instagram} target="_blank" rel="noopener">Instagram ↗</a>}
				<span class="lang" role="group" aria-label="Language">
					<button data-lang="en">EN</button><span aria-hidden="true">/</span><button data-lang="de">DE</button>
				</span>
			</div>
		</div>
	</div>

	<header class="site-header">
		<span class="lang lang--header" role="group" aria-label="Language">
			<button data-lang="en">EN</button><span aria-hidden="true">/</span><button data-lang="de">DE</button>
		</span>
		<a class="wordmark" data-magnetic href="/">Raveenthiran</a>
		<button class="toggle" data-ovl-toggle aria-label="Menu" aria-expanded="false">
			<span></span><span></span><span></span>
		</button>
		<button class="theme-toggle" data-theme-toggle aria-label="Toggle light / dark">
			<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
			<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
		</button>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="site-footer">
		<a class="wordmark wordmark--foot" data-magnetic href="/">Raveenthiran</a>
		<span class="foot__rule" aria-hidden="true"></span>
		<a class="foot__email" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
		<p class="foot__sub"><span data-i18n="foot.sub_or">or</span> <a href="/enquire/" data-i18n="foot.sub_enquiry">start an enquiry</a> <span data-i18n="foot.sub_tail">— a firm quote within 24 hours.</span></p>

		<div class="foot__coords">
			<span>48.2082° N</span><span>16.3738° E</span>
		</div>

		<div class="foot__cols">
			<div class="foot__col">
				<h3 data-i18n="foot.studio">Studio</h3>
				<p>{site.contact.location}</p>
				<p>{site.contact.response}</p>
				<p><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></p>
			</div>
			<div class="foot__col">
				<h3 data-i18n="foot.recent">Recent work</h3>
				{recent.map((p) => <p><a href={`/work/${p.slug}/`}>{p.title}</a></p>)}
			</div>
			<div class="foot__col">
				<h3 data-i18n="foot.albums">Albums</h3>
				{albums.map((a) => <p><a href={`/work/#${slugify(a)}`}>{a}</a></p>)}
			</div>
		</div>

		<div class="foot__base">
			<span>© {year} Nishuthan Raveenthiran</span>
			<span class="foot__social">
				{site.contact.instagram && <a href={site.contact.instagram} target="_blank" rel="noopener">Instagram</a>}
				<a href="/work/">Work</a>
				<a href="/journal/">Journal</a>
				<a href="/enquire/">Enquire</a>
			</span>
		</div>
	</footer>

	<script>
		import '../scripts/ui.js';
	</script>
</body>
</html>
