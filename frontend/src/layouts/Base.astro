---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/instrument-sans';
import '../styles/theme.css';
import { ClientRouter } from 'astro:transitions';

export interface Props {
	title: string;
	description?: string;
	active?: string;
	ogImage?: string;
}
const { title, description = '', active = '', ogImage = '' } = Astro.props;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23f4f2ec'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%231a1917'/%3E%3C/svg%3E";
const nav = [
	{ key: 'work', label: 'Work', href: '/work/' },
	{ key: 'studio', label: 'Studio', href: '/about/' },
	{ key: 'enquire', label: 'Enquire', href: '/enquire/' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<meta property="og:title" content={title} />
	{description && <meta property="og:description" content={description} />}
	{ogImage && <meta property="og:image" content={ogImage} />}
	<meta name="theme-color" content="#f4f2ec" />
	<link rel="icon" href={favicon} />
	<script is:inline>
		try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
	</script>
	<ClientRouter />
</head>
<body>
	<a class="skip-link" href="#main">Skip to content</a>

	<header class="site-header">
		<a class="wordmark" href="/">Raveenthiran</a>
		<nav class="nav" aria-label="Primary">
			{nav.map((n) => (
				<a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
			))}
			<button class="theme-toggle" data-theme-toggle aria-label="Toggle light / dark">
				<svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"/></svg>
				<svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/></svg>
			</button>
		</nav>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="site-footer">
		<span>© {year} Nishuthan Raveenthiran</span>
		<span>Vienna · working across Europe</span>
		<a href="/enquire/">Enquire →</a>
	</footer>

	<script>
		import '../scripts/ui.js';
	</script>
</body>
</html>
