---
import '../styles/theme.css';

export interface Props {
	title: string;
	description?: string;
	active?: string;
}
const { title, description = '', active = '' } = Astro.props;
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%230a0a0b'/%3E%3Ccircle cx='16' cy='16' r='4' fill='%23ecebe8'/%3E%3C/svg%3E";
const nav = [
	{ key: 'work', label: 'Work', href: '/work/' },
	{ key: 'studio', label: 'Studio', href: '/about/' },
	{ key: 'enquire', label: 'Enquire', href: '/enquire/' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<meta name="theme-color" content="#0a0a0b" />
	<link rel="icon" href={favicon} />
</head>
<body>
	<a class="skip-link" href="#main">Skip to content</a>

	<header class="site-header">
		<a class="wordmark" href="/">Raveenthiran</a>
		<nav class="nav" aria-label="Primary">
			{nav.map((n) => (
				<a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
			))}
		</nav>
	</header>

	<main id="main">
		<slot />
	</main>

	<footer class="site-footer">
		<span>© {year} Nishuthan Raveenthiran</span>
		<span>Vienna · working across Europe</span>
		<a href="/enquire/">Enquire →</a>
	</footer>
</body>
</html>
