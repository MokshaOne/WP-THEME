---
import Base from '../layouts/Base.astro';
---
<Base title="Not found — Raveenthiran" description="This page could not be found.">
	<section class="notfound">
		<span class="flourish notfound__flourish" aria-hidden="true">lost?</span>
		<span class="eyebrow" data-i18n="nf.eyebrow">Error 404</span>
		<h1 class="notfound__title" data-i18n="nf.title">This frame is empty.</h1>
		<p class="notfound__lead" data-i18n="nf.lead">The page you were looking for isn’t here — it may have moved, or never existed.</p>
		<div class="notfound__links">
			<a class="btn" href="/" data-i18n="nf.home">Back home</a>
			<a class="notfound__alt" href="/work/" data-i18n="nf.browse">Browse the work →</a>
		</div>
	</section>
</Base>
