---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/wp';

const site = await getSite();
const portrait = site.studio.portrait || '/sample/self-portrait.png';

const statementLines = site.studio.statement;
const bio = 'Vienna-based, working across Austria. Portrait, fashion, event and wedding — planned like productions, shot with intent, delivered on time. You deal with me directly, from first call to final print.';
const spec = site.studio.spec.map((s) => [s.label, s.value] as [string, string]);
const process = [
	['01', 'THE CALL', 'We talk intent, references and location. You get a fixed quote — no surprises later.'],
	['02', 'THE SHOOT', 'Prepared, directed, unhurried. Most people hate being photographed — until this part.'],
	['03', 'THE DELIVERY', 'Hand-edited selects in full resolution, ready for print — delivered when promised.'],
];
---
<Base title="About — Raveenthiran" description="Nishuthan Raveenthiran — photographer based in Vienna, working across Austria." active="studio" page="studio" preload={portrait}>
	<section class="studio-hero">
		<div class="studio-hero__portrait" data-intro>
			<img src={portrait} alt="Nishuthan Raveenthiran" data-parallax="0.07" />
			<div class="credit">NISHUTHAN RAVEENTHIRAN — VIENNA</div>
		</div>
		<div class="studio-hero__body">
			<div>
				<div class="eyebrow" data-intro style="margin-bottom:20px">01 — ABOUT THE STUDIO</div>
				{statementLines.map((l, i) => (
					<div class:list={['line', i === statementLines.length - 1 && 'line--outline']} data-intro>{l}</div>
				))}
			</div>
			<div data-intro style="display:flex;flex-direction:column;gap:34px">
				<p>{bio}</p>
				<div class="spec">
					{spec.map(([k, v]) => <><span class="k">{k}</span><span>{v}</span></>)}
				</div>
				<a class="btn" href="/enquire/" style="align-self:start">Start a commission</a>
			</div>
		</div>
	</section>

	<section class="process" data-reveal>
		{process.map(([no, t, body]) => (
			<div class="process__step">
				<div class="no">{no}</div>
				<div class="t">{t}</div>
				<p>{body}</p>
			</div>
		))}
	</section>

	<!-- PROOF — numbers, then names -->
	{site.studio.stats.length > 0 && (
		<section class="stats" data-reveal>
			{site.studio.stats.map((s) => (
				<div class="stat"><b>{s.value}</b><span>{s.label}</span></div>
			))}
		</section>
	)}
	{site.studio.clients.length > 0 && (
		<section class="clients" data-reveal>
			<span class="k">SEEN AT · WORKED WITH</span>
			{site.studio.clients.map((c) => <span>{c}</span>)}
		</section>
	)}

	<a class="cta cta--sm" href="/enquire/"><span>LET'S TALK</span><span>→</span></a>
</Base>
