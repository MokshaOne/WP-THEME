---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/wp';

const site = await getSite();
const s = site.studio;
const c = site.contact;
const igHandle = c.instagram ? '@' + c.instagram.replace(/\/+$/, '').split('/').pop() : '';
---
<Base title="Studio — Raveenthiran" description={s.lede} active="studio">
	<div class="page">
		<div class="page-head studio-head" data-reveal>
			<span class="flourish studio-flourish" aria-hidden="true">Vienna</span>
			<span class="eyebrow">{c.location}</span>
			<h1 class="page-title">The Studio</h1>
		</div>

		<p class="studio-lede" data-reveal>{s.lede}</p>

		<div class="two-col" data-reveal>
			<div class="prose" set:html={s.bio} />
			<div>
				{s.portrait && <img class="studio-portrait" src={s.portrait} alt="Nishuthan Raveenthiran" loading="lazy" />}
				<dl class="contact-list">
					<div class="row"><span class="k">Email</span><a href={`mailto:${c.email}`}>{c.email}</a></div>
					<div class="row"><span class="k">Studio</span><span>{c.location}</span></div>
					<div class="row"><span class="k">Response</span><span>{c.response}</span></div>
					{c.instagram && <div class="row"><span class="k">Instagram</span><a href={c.instagram} target="_blank" rel="noopener">{igHandle}</a></div>}
				</dl>
			</div>
		</div>

		{s.stats.length > 0 && (
			<div class="stats" data-reveal data-countup>
				{s.stats.map((st) => (
					<div class="stat"><span class="stat__v" data-count={st.value}>{st.value}</span><span class="stat__k">{st.label}</span></div>
				))}
			</div>
		)}

		{s.clients.length > 0 && (
			<div class="clients-block" data-reveal>
				<p class="eyebrow">Selected clients</p>
				<div class="clients">{s.clients.map((cl) => <span class="client">{cl}</span>)}</div>
			</div>
		)}
	</div>
</Base>
