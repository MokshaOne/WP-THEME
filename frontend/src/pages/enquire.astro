---
import Base from '../layouts/Base.astro';
import { getSite } from '../lib/wp';

const site = await getSite();
const CUR = site.pricing.currency || '€';
const EMAIL = site.contact.email;
const types = site.pricing.types;
const extras = site.pricing.addons;
const licence = site.pricing.licence;
const perKm = site.pricing.per_km;
const faq = site.faq;
const money = (n: number) => CUR + Math.round(n).toLocaleString('en-US');
const WP_BASE = (import.meta.env.WP_BASE as string) || 'https://wp.m1o.at/wp-json/wp/v2';
const endpoint = WP_BASE.replace(/\/wp\/v2\/?$/, '') + '/rvn/v1/enquiry';
---
<Base title="Enquire — Raveenthiran" description="Start a photography project — instant estimate, firm quote by email within 24 hours." active="enquire">
	<div class="page">
		<div class="page-head" data-reveal>
			<span class="eyebrow">Enquire · Vienna</span>
			<h1 class="page-title">Start a project</h1>
			<p class="page-lead">Tell me what you have in mind. Get an instant estimate — a firm quote follows by email within 24 hours.</p>
		</div>

		<div class="two-col" data-reveal>
			<form class="form" method="post" action={`mailto:${EMAIL}`} data-price-engine data-currency={CUR} data-mailto={EMAIL} data-endpoint={endpoint}>
				<input type="hidden" name="estimate" value="" data-estimate-input />
				<input type="hidden" name="breakdown" value="" data-breakdown />
				<div class="hp" aria-hidden="true"><label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label></div>

				<div class="field">
					<span class="field-label">01 · Project type</span>
					<div class="chips">
						{types.map((t, i) => (
							<label class="chip"><input type="radio" name="project_type" value={t.label} data-base={t.base} checked={i === 0} /><span>{t.label} · {money(t.base)}</span></label>
						))}
					</div>
				</div>

				{extras.length > 0 && (
					<div class="field">
						<span class="field-label">02 · Add-ons</span>
						<div class="chips">
							{extras.map((x) => (
								<label class="chip"><input type="checkbox" name="addons[]" value={x.label} data-price={x.price} /><span>{x.label} · +{money(x.price)}</span></label>
							))}
						</div>
					</div>
				)}

				<div class="field field--inline">
					{licence > 0 && (
						<label class="chip"><input type="checkbox" name="license" value="1" data-price={licence} /><span>Commercial licence · +{money(licence)}</span></label>
					)}
					{perKm > 0 && (
						<label class="km"><span>Travel (km)</span><input type="number" name="travel_km" min="0" step="1" value="0" data-per-km={perKm} /></label>
					)}
				</div>

				<div class="field">
					<span class="field-label">03 · Your details</span>
					<div class="field"><label for="f-name">Name</label><input id="f-name" type="text" name="name" required /></div>
					<div class="field"><label for="f-email">Email</label><input id="f-email" type="email" name="email" required /></div>
					<div class="field"><label for="f-date">Preferred date</label><input id="f-date" type="date" name="preferred_date" /></div>
					<div class="field"><label for="f-notes">Tell me about it</label><textarea id="f-notes" name="notes" rows="4" required></textarea></div>
				</div>

				<button type="submit" class="btn" data-submit>Send enquiry →</button>
				<p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>
			</form>

			<aside class="enquire-side">
				<div class="big-estimate">
					<span class="k">Estimate</span>
					<output class="v" data-estimate role="status" aria-live="polite" aria-atomic="true">—</output>
					<span class="note">Indicative — the final quote is confirmed by email once we’ve talked through the details.</span>
				</div>
				<dl class="contact-list">
					<div class="row"><span class="k">Email</span><a href={`mailto:${EMAIL}`}>{EMAIL}</a></div>
					<div class="row"><span class="k">Studio</span><span>{site.contact.location}</span></div>
					<div class="row"><span class="k">Response</span><span>{site.contact.response}</span></div>
				</dl>
			</aside>
		</div>

		{faq.length > 0 && (
			<div class="faq" data-reveal>
				<h2 class="page-title" style="font-size:clamp(1.8rem,4vw,2.8rem);margin-bottom:1rem">Questions</h2>
				{faq.map((f) => <details><summary>{f.q}</summary><div class="a"><p>{f.a}</p></div></details>)}
			</div>
		)}
	</div>
</Base>
