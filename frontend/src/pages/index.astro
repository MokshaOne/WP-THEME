---
import Base from '../layouts/Base.astro';
import { getProjects, getSite } from '../lib/wp';
import Default from '../components/home/Default.astro';
import Monument from '../components/home/Monument.astro';
import IndexHome from '../components/home/Index.astro';
import Editorial from '../components/home/Editorial.astro';
import Cinema from '../components/home/Cinema.astro';
import BlockSlot from '../components/blocks/BlockSlot.astro';

const projects = await getProjects();
const site = await getSite();

const featured = (projects.filter((p) => p.featured_home).length ? projects.filter((p) => p.featured_home) : projects).slice(0, 6);
const preload = featured[0]?.image || '';

// Chosen in WordPress → Site settings → Home → Layout.
const VARIANTS: Record<string, any> = { raveenthiran: Default, monument: Monument, index: IndexHome, editorial: Editorial, cinema: Cinema };
// HOME_VARIANT env is a preview override (screenshots); WordPress drives it in production.
const chosen = (import.meta.env.HOME_VARIANT as string) || site.home.variant;
const Home = VARIANTS[chosen] || Default;
---
<Base title="Raveenthiran — Photographer, Vienna" description={site.home.hero_lede} active="" page="home" preload={preload}
	ogImage={featured[0]?.ogImage || featured[0]?.image || ''}>
	<BlockSlot site={site} slotName="home-top" />
	<Home site={site} projects={projects} />
	<BlockSlot site={site} slotName="home-bottom" />
</Base>
