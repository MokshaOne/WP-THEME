---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/wp';

const projects = (await getProjects()).slice(0, 6);
const grads = [
	'linear-gradient(135deg,#17171a,#0b0b0d 60%,#080809)',
	'linear-gradient(120deg,#1a1712,#0d0b09 55%,#080706)',
	'linear-gradient(150deg,#12161a,#090a0d 60%,#070709)',
	'linear-gradient(120deg,#1a1410,#0c0906 58%,#070604)',
	'linear-gradient(160deg,#141418,#08080b 60%,#070708)',
	'linear-gradient(135deg,#1b1113,#0d0708 55%,#080505)',
];
---
<Base
	title="Raveenthiran — Photography"
	description="Selected photography by Nishuthan Raveenthiran — Vienna, working across Europe."
	active=""
>
	<section class="hero" data-hero>
		{projects.map((p, i) => (
			<div class={`hero__slide${i === 0 ? ' is-on' : ''}`} data-slide={i}>
				{p.image
					? <img class="hero__media" src={p.image} alt={p.title} loading={i === 0 ? 'eager' : 'lazy'} />
					: <div class="hero__ph" style={`background:${grads[i % grads.length]}`}><span>{p.title.toLowerCase()}</span></div>}
				<div class="hero__scrim"></div>
			</div>
		))}

		<div class="hero__cap">
			<h1 class="hero__title" data-hero-title>{projects[0]?.title}</h1>
			<div class="hero__meta">
				<div class="eyebrow" data-hero-cat>{projects[0]?.category}</div>
				<a href={`/work/${projects[0]?.slug}/`} data-hero-link>View project <span>→</span></a>
			</div>
		</div>

		<div class="hero__dots">
			{projects.map((_p, i) => <button class={`hero__dot${i === 0 ? ' is-on' : ''}`} data-dot={i} aria-label={`Slide ${i + 1}`}></button>)}
		</div>
	</section>
</Base>

<script is:inline define:vars={{ data: projects.map((p) => ({ title: p.title, category: p.category, slug: p.slug })) }}>
	(function () {
		var hero = document.querySelector('[data-hero]');
		if (!hero || data.length < 2) return;
		var slides = hero.querySelectorAll('.hero__slide');
		var dots = hero.querySelectorAll('.hero__dot');
		var titleEl = hero.querySelector('[data-hero-title]');
		var catEl = hero.querySelector('[data-hero-cat]');
		var linkEl = hero.querySelector('[data-hero-link]');
		var reduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
		var i = 0, timer = null;
		function go(n) {
			i = (n + data.length) % data.length;
			slides.forEach(function (s, k) { s.classList.toggle('is-on', k === i); });
			dots.forEach(function (d, k) { d.classList.toggle('is-on', k === i); });
			titleEl.textContent = data[i].title;
			catEl.textContent = data[i].category;
			linkEl.setAttribute('href', '/work/' + data[i].slug + '/');
		}
		function arm() { if (!reduce) timer = setInterval(function () { go(i + 1); }, 5200); }
		dots.forEach(function (d, k) { d.addEventListener('click', function () { go(k); clearInterval(timer); arm(); }); });
		arm();
	})();
</script>
