---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/wp';

const all = await getProjects();
const featured = all.filter((p) => p.featured_home);
const projects = (featured.length ? featured : all).slice(0, 6);
const grads = [
	'linear-gradient(135deg,#2a2824,#17140f)', 'linear-gradient(120deg,#232830,#12161c)',
	'linear-gradient(150deg,#2c2622,#171210)', 'linear-gradient(120deg,#26262c,#141418)',
	'linear-gradient(160deg,#2a2026,#160f13)', 'linear-gradient(135deg,#202a26,#101613)',
];
---
<Base
	title="Raveenthiran — Photography"
	description="Selected photography by Nishuthan Raveenthiran — portraiture, weddings, street and the quiet spaces between. Vienna, working across Europe."
>
	<section class="hero" data-hero>
		{projects.map((p, i) => (
			<div class={`hero__slide${i === 0 ? ' is-on' : ''}`} data-slide={i} data-title={p.title} data-cat={p.category} data-slug={p.slug}>
				{p.image
					? <img class="hero__media" src={p.image} alt={p.title} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} />
					: <div class="hero__ph" style={`background:${grads[i % grads.length]}`}><span>{p.title.toLowerCase()}</span></div>}
				<div class="hero__scrim"></div>
			</div>
		))}

		<div class="hero__inner">
			<div class="hero__eyebrow" data-hero-eyebrow>{projects[0]?.category}</div>
			<h1 class="hero__title" data-hero-title>{projects[0]?.title}</h1>
			<a class="hero__cta" href={`/work/${projects[0]?.slug}/`} data-hero-link>View project →</a>
		</div>

		<div class="hero__dots">
			{projects.map((_p, i) => <button class={`hero__dot${i === 0 ? ' is-on' : ''}`} data-dot={i} aria-label={`Slide ${i + 1}`}><i></i></button>)}
		</div>
	</section>
</Base>
