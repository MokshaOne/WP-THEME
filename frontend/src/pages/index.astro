---
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/wp';

const all = await getProjects();
const featured = all.filter((p) => p.featured_home);
const projects = (featured.length ? featured : all).slice(0, 6);
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const grads = [
	'linear-gradient(135deg,#2a2824,#17140f)', 'linear-gradient(120deg,#232830,#12161c)',
	'linear-gradient(150deg,#2c2622,#171210)', 'linear-gradient(120deg,#26262c,#141418)',
	'linear-gradient(160deg,#2a2026,#160f13)', 'linear-gradient(135deg,#202a26,#101613)',
];
---
<Base
	title="Raveenthiran — Photography"
	description="Selected photography by Nishuthan Raveenthiran — portraiture, weddings, street and the quiet spaces between. Vienna, working across Europe."
>
	<section class="home-hero" data-reveal>
		<h1 class="home-hero__title">A photography practice in <a href="/about/">Vienna</a>, keeping the portraits, weddings and quiet moments that last.</h1>
		<p class="home-hero__desc">Nishuthan Raveenthiran</p>
	</section>

	<div class="masonry stagger">
		{projects.map((p, i) => (
			<a class="tile" href={`/work/${p.slug}/`} data-reveal>
				<div class="tile__frame">
					{p.image
						? <img class="tile__img" src={p.image} alt={p.title} loading={i < 2 ? 'eager' : 'lazy'} transition:name={`cover-${p.slug}`} />
						: <div class="tile__ph" style={`background:${grads[i % grads.length]};aspect-ratio:4/5`} transition:name={`cover-${p.slug}`}>{p.title.toLowerCase()}</div>}
				</div>
				<div class="tile__cap">
					<span class="tile__t">{p.title}</span>
					<span class="tile__c">{p.category || 'Series'}</span>
				</div>
			</a>
		))}
	</div>
</Base>
