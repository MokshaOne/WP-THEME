---
import Base from '../../layouts/Base.astro';
import { getPosts, getPost } from '../../lib/wp';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.slug },
		props: { next: posts[(i + 1) % posts.length] },
	}));
}

const { slug } = Astro.params;
const { next } = Astro.props;
const post = (await getPost(slug!))!;
const up = (s: string) => (s || '').toUpperCase();
---
<Base title={`${post.title} — Journal`} description={post.excerpt} active="journal" page="article" ogImage={post.image} preload={post.image}>
	<article class="article">
		<div class="eyebrow" data-intro style="margin-bottom:20px">{up(post.category)} · {post.dateLabel.toUpperCase()}</div>
		<h1 data-intro>{up(post.title)}</h1>
		{post.image && (
			<div class="plate" data-reveal style="margin:40px 0"><img src={post.image} srcset={post.imageSrcset || undefined} sizes="(max-width: 900px) 100vw, 900px" width={post.imageW || undefined} height={post.imageH || undefined} alt={post.title} data-zoom loading="eager" fetchpriority="high" /></div>
		)}
		<div class="article__body" data-reveal set:html={post.content} />
	</article>

	{next && next.slug !== post.slug && (
		<a class="cta cta--sm" href={`/journal/${next.slug}/`}>
			<span style="font-family:var(--font-body);font-size:11px;letter-spacing:0.22em;color:var(--faint)">NEXT ENTRY</span>
			<span>{up(next.title)} →</span>
		</a>
	)}
</Base>
