---
import Base from '../../layouts/Base.astro';
import { getPosts, getPost } from '../../lib/wp';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.slug },
		props: { next: posts[(i + 1) % posts.length] },
	}));
}

const { slug } = Astro.params;
const { next } = Astro.props;
const post = (await getPost(slug!))!;
---
<Base title={`${post.title} — Journal`} description={post.excerpt} active="journal" ogImage={post.image} preload={post.image}>
	<article class="entry">
		<header class="entry__head" data-reveal>
			<span class="eyebrow">{post.category} · {post.dateLabel}</span>
			<h1 class="entry__title">{post.title}</h1>
		</header>

		{post.image && (
			<div class="entry__hero" data-reveal>
				<img src={post.image} alt={post.title} width={post.imageW || undefined} height={post.imageH || undefined} />
			</div>
		)}

		<div class="entry__body prose" data-reveal set:html={post.content} />
	</article>

	{next && next.slug !== post.slug && (
		<a class="next-proj" href={`/journal/${next.slug}/`}>
			<span class="next-proj__k">Next entry</span>
			<span class="next-proj__t">{next.title}</span>
			<span class="next-proj__c">{next.category} · {next.dateLabel} →</span>
		</a>
	)}

	<nav class="entry-nav">
		<a href="/journal/">← All entries</a>
		<a href="/enquire/">Enquire about a shoot →</a>
	</nav>
</Base>
