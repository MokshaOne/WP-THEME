---
import Base from '../layouts/Base.astro';
---
<Base title="Offline — Raveenthiran" description="You are offline.">
	<section class="notfound">
		<span class="flourish notfound__flourish" aria-hidden="true">offline</span>
		<span class="eyebrow">No connection</span>
		<h1 class="notfound__title">You’re offline.</h1>
		<p class="notfound__lead">This page isn’t cached yet. Reconnect and try again — recently visited pages still work offline.</p>
		<div class="notfound__links">
			<a class="btn" href="/">Back home</a>
		</div>
	</section>
</Base>
