---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/wp';

export async function getStaticPaths() {
	const projects = await getProjects();
	const seen = new Map<string, string>();
	for (const p of projects) for (const s of p.series || []) if (!seen.has(s.slug)) seen.set(s.slug, s.name);
	return Array.from(seen.entries()).map(([slug, name]) => ({ params: { slug }, props: { name } }));
}

const { slug } = Astro.params;
const { name } = Astro.props;
const projects = (await getProjects()).filter((p) => (p.series || []).some((s) => s.slug === slug));
const up = (s: string) => (s || '').toUpperCase();
const num = (n: number) => String(n).padStart(3, '0');
---
<Base title={`${name} — Series — Raveenthiran`} description={`${name} — a series of photography projects by Nishuthan Raveenthiran.`} active="series" page="series">
	<section class="phead">
		<h1 data-intro>{up(name)}</h1>
		<div class="phead__meta" data-intro>SERIES<br />{String(projects.length).padStart(2, '0')} {projects.length === 1 ? 'PROJECT' : 'PROJECTS'}</div>
	</section>

	<section class="masonry" data-work-grid>
		{projects.map((p, i) => (
			<a class="card" href={`/work/${p.slug}/`}>
				<div class="plate"><img src={p.image} srcset={p.imageSrcset || undefined} sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 33vw" width={p.imageW || undefined} height={p.imageH || undefined} alt={p.title} data-zoom loading={i < 3 ? 'eager' : 'lazy'} /></div>
				<div class="cap"><span class="n">{num(i + 1)}</span><span>{up(p.title)}</span><span class="c">{p.year}</span></div>
			</a>
		))}
	</section>

	<a class="cta cta--sm" href="/series/"><span>ALL SERIES</span><span>→</span></a>
</Base>
