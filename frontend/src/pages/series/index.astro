---
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/wp';

const projects = await getProjects();
const map = new Map<string, { name: string; slug: string; items: typeof projects }>();
for (const p of projects) {
	for (const s of p.series || []) {
		if (!map.has(s.slug)) map.set(s.slug, { name: s.name, slug: s.slug, items: [] });
		map.get(s.slug)!.items.push(p);
	}
}
const series = Array.from(map.values()).sort((a, b) => a.name.localeCompare(b.name));
const up = (s: string) => (s || '').toUpperCase();
const num = (n: number) => String(n).padStart(3, '0');
---
<Base title="Series — Raveenthiran" description="Bodies of work — projects grouped into named series." active="series" page="series">
	<section class="phead">
		<h1 data-intro>SERIES</h1>
		<div class="phead__meta" data-intro>BODIES OF WORK<br />{String(series.length).padStart(2, '0')} SERIES</div>
	</section>

	{series.length > 0 ? (
		<div class="index" style="border-top:1px solid var(--line);margin-top:44px">
			{series.map((s, i) => {
				const cover = s.items.find((p) => p.image);
				return (
					<a class="index__row" href={`/series/${s.slug}/`} data-peek data-img={cover?.image || ''}>
						<span class="k">{num(i + 1)}</span>
						<span class="t">{up(s.name)}</span>
						<span class="k cat">{s.items.length} {s.items.length === 1 ? 'PROJECT' : 'PROJECTS'}</span>
						<span class="k year">→</span>
					</a>
				);
			})}
		</div>
	) : (
		<p class="wrap" style="padding:60px 28px;color:var(--dim);letter-spacing:0.06em">No series yet — group projects under a series in WordPress (Work → Series).</p>
	)}

	<a class="cta cta--sm" href="/work/"><span>SEE ALL WORK</span><span>→</span></a>
</Base>
