---
import Base from '../../layouts/Base.astro';
import { getProjects, getProject } from '../../lib/wp';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p, i) => ({
		params: { slug: p.slug },
		props: { index: i, next: projects[(i + 1) % projects.length] },
	}));
}

const { slug } = Astro.params;
const { index, next } = Astro.props;
const p = (await getProject(slug!))!;

const up = (s: string) => (s || '').toUpperCase();
const titleLines = up(p.title).split(/\s*—\s*|\s*·\s*/).filter(Boolean);
const eyebrow = `FIG. ${String(index + 1).padStart(3, '0')} — ${up(p.category || 'WORK')} — ${p.year}`;

const meta = ([
	['CLIENT', p.client],
	['LOCATION', p.location],
	['SERVICES', p.services.join(' · ')],
] as [string, string][]).filter(([, v]) => v);

const gallery = p.gallery.length ? p.gallery : [{ src: p.image, w: p.imageW || 0, h: p.imageH || 0 }];
---
<Base title={`${p.title} — Raveenthiran`} description={`${p.title} — ${p.category || 'project'} photography by Nishuthan Raveenthiran.`} active="work" page="project" ogImage={p.ogImage || p.image} preload={p.image}>
	<!-- SPLIT HERO -->
	<section class="proj-hero">
		<div class="proj-hero__left">
			<div>
				<div class="eyebrow" data-intro style="margin-bottom:20px">{eyebrow}</div>
				<div class="proj-hero__title">
					{(titleLines.length ? titleLines : [up(p.title)]).map((l) => <div class="line" data-intro>{l}</div>)}
				</div>
			</div>
			{meta.length > 0 && (
				<div class="meta-row" data-intro>
					{meta.map(([k]) => <span class="k">{k}</span>)}
					{meta.map(([, v]) => <span>{v}</span>)}
				</div>
			)}
		</div>
		<div class="proj-hero__right" data-intro>
			<img src={p.image} alt={p.title} data-parallax="0.08" transition:name={`cover-${p.slug}`} />
		</div>
	</section>

	<!-- GALLERY RAIL -->
	<section class="proj-gallery">
		<div class="rail" data-drag>
			{gallery.map((g, i) => (
				<div class="card">
					<div class="plate"><img src={g.src} srcset={g.srcset || undefined} alt={`${p.title} — ${i + 1}`} data-zoom loading={i === 0 ? 'eager' : 'lazy'} /></div>
					<div class="cap"><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{up(p.title)}</span></div>
				</div>
			))}
		</div>
		<div class="wrap" style="padding-top:24px;font-size:11px;letter-spacing:0.2em;color:var(--faint)">SCROLL SIDEWAYS ——→</div>
	</section>

	<!-- STATEMENT + CREDITS -->
	<section class="proj-statement" data-reveal>
		{p.content
			? <div set:html={p.content} />
			: <p>{`${p.category || 'A photographic'} series${p.location ? ` made in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''}.`}</p>}
		<div class="credits">
			{p.credits.length > 0
				? p.credits.map((c) => (<><span class="k">{up(c.role)}</span><span>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}</span></>))
				: (<><span class="k">PHOTOGRAPHY</span><span>NISHUTHAN RAVEENTHIRAN</span></>)}
			{(p.series || []).length > 0 && (
				<><span class="k">SERIES</span><span>{(p.series || []).map((s) => <a class="chipline" href={`/series/${s.slug}/`}>{up(s.name)}</a>)}</span></>
			)}
			{p.website && (
				<><span class="k">WEBSITE</span><span><a href={p.website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></span></>
			)}
		</div>
	</section>

	<!-- NEXT PROJECT -->
	{next && next.slug !== p.slug && (
		<a class="cta cta--sm" href={`/work/${next.slug}/`}>
			<span style="font-family:var(--font-body);font-size:11px;letter-spacing:0.22em;color:var(--faint)">NEXT PROJECT</span>
			<span>{up(next.title)} →</span>
		</a>
	)}
</Base>
