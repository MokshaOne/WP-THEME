---
import Base from '../../layouts/Base.astro';
import { getProjects, getProject } from '../../lib/wp';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = (await getProject(slug!))!;

const meta = ([
	['Client', p.client],
	['Role', p.role],
	['Year', p.year],
	['Location', p.location],
] as [string, string][]).filter(([, v]) => v);

// Demo placeholders when a project has no gallery yet (offline / first run).
const items = p.gallery.length
	? p.gallery.map((g) => ({ src: g.src, srcset: g.srcset || '', label: '' }))
	: Array.from({ length: 6 }, (_v, i) => ({ src: '', srcset: '', label: `${p.title} · plate ${String(i + 1).padStart(2, '0')}` }));
---
<Base title={`${p.title} — Raveenthiran`} description={`${p.title} — ${p.category || 'project'} photography by Nishuthan Raveenthiran.`} active="work">
	<div class="proj__hero">
		{p.image
			? <img src={p.image} alt={p.title} />
			: <div class="proj__ph"><span>{p.title.toLowerCase()}</span></div>}
	</div>

	<div class="proj__head">
		<div>
			<p class="eyebrow">{p.category || 'Project'}</p>
			<h1 class="proj__title">{p.title}</h1>
			{p.content
				? <div class="proj__body" set:html={p.content} />
				: <div class="proj__body"><p>A {(p.category || 'photographic').toLowerCase()} series{p.location ? ` made in ${p.location}` : ''}{p.year ? `, ${p.year}` : ''}. The full edit lives in the gallery below.</p></div>}
		</div>
		<div>
			{(meta.length || p.website) && (
				<dl class="meta-dl">
					{meta.map(([k, v]) => <div class="row"><span class="k">{k}</span><span>{v}</span></div>)}
					{p.website && (
						<div class="row"><span class="k">Website</span>
							<a href={p.website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
						</div>
					)}
				</dl>
			)}
		</div>
	</div>

	<div class="gallery" data-gallery>
		{items.map((it, i) => (
			<figure data-i={i} data-src={it.src} data-label={it.label}>
				{it.src
					? <img src={it.src} srcset={it.srcset} sizes="(max-width:640px) 96vw, 48vw" alt={`${p.title} — ${i + 1}`} loading="lazy" />
					: <span class="g-ph">{String(i + 1).padStart(2, '0')}</span>}
			</figure>
		))}
	</div>

	<nav class="entry-nav">
		<a href="/work/">← All work</a>
		<a href="/enquire/">Enquire about a shoot →</a>
	</nav>

	<!-- lightbox -->
	<div class="lb" data-lb aria-hidden="true" role="dialog" aria-modal="true" aria-label="Image viewer">
		<div class="lb__bar">
			<span data-lb-count>1 / {items.length}</span>
			<button class="lb__close" data-lb-close aria-label="Close">✕</button>
		</div>
		<button class="lb__nav lb__prev" data-lb-prev aria-label="Previous">←</button>
		<div data-lb-stage></div>
		<button class="lb__nav lb__next" data-lb-next aria-label="Next">→</button>
	</div>
</Base>

<script src="../../scripts/lightbox.js"></script>
