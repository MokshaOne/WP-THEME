---
import type { Site, Project } from '../../lib/wp';
import { jsonForScript } from '../../lib/safe';
import { pad, soften, caption } from '../../lib/format';
import SectionHead from '../ui/SectionHead.astro';
import ProjectCard from '../ui/ProjectCard.astro';
import CtaBand from '../ui/CtaBand.astro';
interface Props { site: Site; projects: Project[]; }
const { site, projects } = Astro.props;

const featuredAll = projects.filter((p) => p.featured_home).length ? projects.filter((p) => p.featured_home) : projects;
const featured = featuredAll.slice(0, 6);
const selected = (projects.length > featured.length ? featured : projects).slice(0, 6);
const indexItems = projects.slice(0, 10);

// Hero label: "001 — PROJECT" / "CATEGORY · VIENNA · YEAR" (upper-cased in CSS).
const heroTitle = (p: Project, i: number) => `${pad(i + 1, 3)} — ${p.title}`;
const heroCap = (p: Project) => caption(p.category, p.location || 'Vienna', p.year);
// Statement lines are shown exactly as WordPress holds them (upper-case by design).
const statement = site.studio.statement.filter(Boolean);
const honors = site.home.honors;
const testimonials = site.home.testimonials;
const hasRecog = honors.length > 0 || testimonials.length > 0;
let sec = 0;
const n = () => pad(++sec);
---
<h1 class="sr-only">Raveenthiran — portrait, fashion and editorial photography in Vienna</h1>

<!-- HERO — the photograph, edge to edge; one small mono label bottom-left -->
<section class="hero" data-hero aria-roledescription="carousel" aria-label="Selected work">
	<div class="hero__slides">
		{/* All frames load eagerly so the crossfade never reveals an empty slide;
		    only the first one competes for LCP priority. */}
		{featured.map((p, i) => (
			<img class:list={['slide', i === 0 && 'on']} src={p.image} srcset={p.imageSrcset || undefined} sizes="100vw"
				width={p.imageW || undefined} height={p.imageH || undefined} alt={p.title}
				data-title={heroTitle(p, i)} data-cap={heroCap(p)} data-href={`/work/${p.slug}/`}
				style={p.focal ? `--focal:${p.focal}` : undefined} loading="eager" decoding="async" fetchpriority={i === 0 ? 'high' : 'low'} />
		))}
	</div>
	<div class="hero__veil" aria-hidden="true"></div>
	{featured[0] && (
		<a class="hero__cap" href={`/work/${featured[0].slug}/`} data-cap-link>
			<span data-title>{heroTitle(featured[0], 0)}</span>
			<span data-cap aria-live="off">{heroCap(featured[0])}</span>
		</a>
	)}
	{/* Pause control stays for keyboard / screen-reader users (WCAG 2.2.2), visible only on focus. */}
	{featured.length > 1 && <button class="btn hero__pause" data-pause aria-pressed="false" aria-label="Pause slideshow">❚❚</button>}
</section>

<!-- ON THE ROAD — planned city dates (only when WordPress holds some) -->
{(site.travel.dates.length > 0 || site.travel.open) && (
	<section class="road" data-reveal>
		<span class="label">On the road — {new Date().getFullYear()}</span>
		{site.travel.dates.map((t) => <span class="road__d">{t.dates}<em>—</em>{soften(t.city)}</span>)}
		{site.travel.open && <a class="link road__open" href="/enquire/">Open for travelling <span class="arr" aria-hidden="true">→</span></a>}
	</section>
)}

<!-- MANIFEST — the studio's voice before the pictures -->
<section class="manifest" data-reveal>
	<div class="label">{n()} — The studio</div>
	<div>
		<p class="manifest__text">{site.studio.lede || 'A practice of looking slowly — and keeping only what lasts.'} <em>Portraits, fashion and editorial, made in Vienna.</em></p>
		<div class="manifest__foot">
			<a class="link" href="/about/">About the studio <span class="arr" aria-hidden="true">→</span></a>
		</div>
	</div>
</section>

<!-- SELECTED WORK — an editorial, asymmetric spread -->
<section class="sec">
	<SectionHead n={n()} kicker="Selected work" href="/work/" linkLabel={`Full archive — ${pad(projects.length)} projects`} />
	<div class="wgrid">
		{selected.map((p, i) => (
			<ProjectCard project={p} index={i + 1} sizes={i === 0 ? '(max-width: 900px) 100vw, 75vw' : '(max-width: 900px) 86vw, 55vw'} />
		))}
	</div>
</section>

<!-- STATEMENT — flush-left serif lines, hairlines between, no label -->
{statement.length > 0 && (
	<section class="stmt" data-reveal>
		{statement.map((l) => <p class="stmt__line">{l}</p>)}
	</section>
)}

<!-- THE INDEX — every project as a line of type, with a floating preview -->
<section class="sec">
	<SectionHead n={n()} kicker="The index" title={`Every project — ${pad(indexItems.length)}`} />
	<div class="index">
		{indexItems.map((p, i) => (
			<a class="index__row" href={`/work/${p.slug}/`} data-peek data-img={p.image}>
				<span class="k">{pad(i + 1, 3)}</span>
				<span class="t">{p.title}</span>
				<span class="k cat">{soften(p.category)}</span>
				<span class="k year">{p.year}</span>
			</a>
		))}
	</div>
</section>

<!-- RECOGNITION — only what WordPress actually holds; never a placeholder -->
{hasRecog && (
	<section class="sec">
		<SectionHead n={n()} kicker="Recognition" />
		<div class:list={['recog', (!honors.length || !testimonials.length) && 'recog--single']}>
			{honors.length > 0 && (
				<div role="table" aria-label="Recognition" data-reveal>
					{honors.map((h) => (
						<div class="honor" role="row">
							<span class="k" role="cell">{h.year}</span>
							<span class="t" role="cell">{h.title}</span>
							<span class="k" role="cell">{h.tag}</span>
						</div>
					))}
				</div>
			)}
			{testimonials.length > 0 && (
				<div class="quotes" data-reveal data-quotes>
					<div class="quotes__mark" aria-hidden="true">&ldquo;</div>
					<div aria-live="polite" aria-atomic="true">
						<p class="quotes__text" data-quote-text>&ldquo;{testimonials[0].text}&rdquo;</p>
					</div>
					<div class="quotes__foot">
						<span class="quotes__by" data-quote-by>{testimonials[0].by}</span>
						{testimonials.length > 1 && (
							<div class="slide-nav">
								<button class="rbtn" data-q-prev aria-label="Previous quote">←</button>
								<span class="slide-count"><span data-quote-count>01</span><span class="of"> / {pad(testimonials.length)}</span></span>
								<button class="rbtn" data-q-next aria-label="Next quote">→</button>
							</div>
						)}
					</div>
				</div>
			)}
		</div>
		{testimonials.length > 0 && <script type="application/json" id="quotes-data" set:html={jsonForScript(testimonials)} is:inline />}
	</section>
)}

<!-- THE PHOTOGRAPHER -->
<section class="whois">
	<a class="whois__plate media" href="/about/" aria-label="About Nishuthan Raveenthiran" data-reveal-img>
		<img src={site.studio.portrait || '/sample/self-portrait.webp'} alt="Nishuthan Raveenthiran" loading="lazy" decoding="async" style="--focal:50% 20%" />
	</a>
	<div data-reveal>
		<div class="label">{n()} — The photographer</div>
		<h2 class="whois__name">Nishuthan <em>Raveenthiran</em></h2>
		<p class="whois__line">{site.studio.lede || 'Portrait, fashion and editorial. Vienna, and wherever the light is worth the drive.'}</p>
		{site.studio.spec.length > 0 && (
			<dl class="whois__spec">
				{site.studio.spec.slice(0, 3).map((r) => <div><dt>{r.label}</dt><dd>{soften(r.value)}</dd></div>)}
			</dl>
		)}
		<a class="btn" href="/about/">About the studio <span class="arr" aria-hidden="true">→</span></a>
	</div>
</section>

<CtaBand href="/enquire/" kicker="Commissions open" label="Book the <em>next shoot</em>" />
