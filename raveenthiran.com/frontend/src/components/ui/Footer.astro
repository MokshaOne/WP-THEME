---
// Footer: copyright, mail, coordinates — Space Mono on ink.
// Impressum / Datenschutz stay linked on every page: Austrian law (§ 5 ECG,
// § 25 MedienG) requires them to be reachable from everywhere.
interface Props { email: string; social: { label: string; href: string }[]; version: string; buildDate: string }
const { email, social, version, buildDate } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer" data-version={`v${version} · ${buildDate}`}>
	<p><span>© {year} Raveenthiran</span><a href="/legal/impressum/">Impressum</a><a href="/legal/datenschutz/">Datenschutz</a></p>
	<p><a href={`mailto:${email}`}>{email}</a>{social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</p>
	<p><span>48.2082° N, 16.3738° E</span></p>
</footer>
