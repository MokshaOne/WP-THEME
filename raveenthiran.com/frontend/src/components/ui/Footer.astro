---
// Site footer: closing line + contact, studio, legal columns, quiet wordmark.
interface Props { email: string; social: { label: string; href: string }[]; version: string; buildDate: string }
const { email, social, version, buildDate } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
	<div class="foot-grid">
		<div>
			<p class="foot-lead">Photographs that <em>outlive</em> the moment.</p>
			<a class="link foot-mail" href={`mailto:${email}`}>{email} <span class="arr" aria-hidden="true">→</span></a>
		</div>
		<div class="foot-col">
			<span class="label">Studio</span>
			<span>Vienna, Austria</span>
			<span class="num">48.2082° N, 16.3738° E</span>
			<a class="foot-live" href="/enquire/">Available for commissions</a>
		</div>
		<div class="foot-col">
			<span class="label">Follow</span>
			{social.length
				? social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)
				: <a href={`mailto:${email}`}>Email ↗</a>}
			<a href="/journal/">Journal</a>
		</div>
		<div class="foot-col">
			<span class="label">Legal</span>
			<a href="/legal/impressum/">Impressum</a>
			<a href="/legal/datenschutz/">Datenschutz</a>
			<a href="/legal/agb/">AGB</a>
		</div>
	</div>
	<svg class="foot-mark" viewBox="0 0 1000 120" aria-hidden="true">
		<text x="0" y="100" textLength="1000" lengthAdjust="spacingAndGlyphs" font-size="132">Raveenthiran</text>
	</svg>
	<div class="foot-bottom">
		<span>© {year} Nishuthan Raveenthiran — Vienna</span>
		<span class="num" title={`Built ${buildDate}`}>v{version} · {buildDate}</span>
	</div>
</footer>
