---
// Site footer: copyright left, coordinates right, one hairline above — nothing else.
// Impressum / Datenschutz stay as quiet text links next to the copyright: Austrian
// law (§ 5 ECG, § 25 MedienG) requires them to be reachable from every page.
interface Props { email: string; social: { label: string; href: string }[]; version: string; buildDate: string }
const { version, buildDate } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer" data-version={`v${version} · ${buildDate}`}>
	<p class="foot-l">
		<span>© {year} Nishuthan Raveenthiran</span>
		<a href="/legal/impressum/">Impressum</a>
		<a href="/legal/datenschutz/">Datenschutz</a>
	</p>
	<p class="foot-r num">48.2082° N, 16.3738° E</p>
</footer>
