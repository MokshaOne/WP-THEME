---
// Site header + mobile overlay. Hides on scroll down, returns on scroll up (fx.js).
interface Props { active: string; email: string; social: { label: string; href: string }[] }
const { active, email, social } = Astro.props;
const nav = [
	{ key: 'work', label: 'Work', href: '/work/' },
	{ key: 'studio', label: 'About', href: '/about/' },
];
---
<header class="site-header" data-header>
	<a class="wordmark" href="/" aria-label="Raveenthiran — home">RAVEENTHIRAN</a>
	<nav class="nav" aria-label="Primary">
		{nav.map((n) => <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>)}
	</nav>
	<div class="hdr-end">
		<span class="hdr-clock" data-clock aria-label="Local time in Vienna"></span>
		<a class="btn hdr-cta" href="/enquire/" aria-current={active === 'enquire' ? 'page' : undefined}>Enquire <span class="arr" aria-hidden="true">→</span></a>
	</div>
	<button class="burger" data-burger aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
</header>

<div class="m-ovl" id="mobile-menu" data-mobile-ovl>
	<nav aria-label="Mobile">
		{[...nav, { key: 'enquire', label: 'Enquire', href: '/enquire/' }].map((n, i) => (
			<a href={n.href} aria-current={active === n.key ? 'page' : undefined}><span class="n">0{i + 1}</span>{n.label}</a>
		))}
	</nav>
	<div class="m-foot">
		<a href={`mailto:${email}`}>{email}</a>
		{social.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
	</div>
</div>
