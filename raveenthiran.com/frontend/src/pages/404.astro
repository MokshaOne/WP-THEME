---
import Base from '../layouts/Base.astro';
---
<Base title="Lost frame — 404 — Raveenthiran" description="This page could not be found." page="404">
	<section class="notfound">
		<p class="label">Error 404</p>
		<h1>Lost <em>frame.</em></h1>
		<p>The page you were looking for isn't here — maybe it was moved, maybe it never made the edit.</p>
		<div class="intro__actions">
			<a class="btn btn--solid" href="/">Back home</a>
			<a class="btn btn--ghost" href="/work/">Browse the work <span class="arr" aria-hidden="true">→</span></a>
		</div>
	</section>
</Base>
