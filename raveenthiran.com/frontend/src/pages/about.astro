---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import { getSite } from '../lib/wp';
import { soften } from '../lib/format';

const site = await getSite();
const portrait = site.studio.portrait || '/sample/self-portrait.webp';

const bio = 'Vienna-based, working across Austria. Portrait, fashion and editorial — planned like productions, shot with intent, delivered on time.';
// Data sheet, as specified for v5.2.
const sheet: [string, string][] = [
	['Based in', 'Vienna, Austria'],
	['Available for', 'Portrait · Fashion · Editorial'],
	['Since', '2020'],
];
const process = [
	['01', 'The call', 'We talk intent, references and location. You get a fixed quote — no surprises later.'],
	['02', 'The shoot', 'Prepared, directed, unhurried. Most people hate being photographed — until this part.'],
	['03', 'The delivery', 'Hand-edited selects in full resolution, ready for print — delivered when promised.'],
];
---
<Base title="About — Raveenthiran" description="Nishuthan Raveenthiran — photographer based in Vienna, working across Austria." active="studio" page="studio" preload={portrait}>
	<section class="studio-hero">
		<figure class="studio-hero__portrait media" data-intro>
			<img src={portrait} alt="Nishuthan Raveenthiran" loading="eager" fetchpriority="high" />
		</figure>
		<div class="studio-hero__body">
			<p class="studio-hero__name" data-intro>RAVEENTHIRAN</p>
			<h1 class="studio-hero__title" data-intro>Portrait &amp; Fashion Photographer, Vienna.</h1>
			<hr class="studio-hero__rule" data-intro />
			<dl class="studio-hero__sheet" aria-label="Studio data sheet" data-intro>
				{sheet.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
			</dl>
			<p class="studio-hero__bio" data-intro>{bio}</p>
			<p class="studio-hero__links" data-intro>
				<a class="link" href="/enquire/">Start a commission</a>
				<a class="link link--quiet" href="/work/">See the work</a>
			</p>
		</div>
	</section>

	<section class="sec">
		<SectionHead kicker="How it works" />
		<ol class="process" data-reveal>
			{process.map(([no, t, body]) => (
				<li class="process__step">
					<div class="no" aria-hidden="true">— {no} —</div>
					<h3 class="t"><span class="sr-only">Step {no}: </span>{t}</h3>
					<p>{body}</p>
				</li>
			))}
		</ol>
	</section>

	<!-- PROOF — numbers, then names (only what WordPress provides) -->
	{site.studio.stats.length > 0 && (
		<section class="stats" data-reveal>
			{site.studio.stats.map((s) => (
				<div class="stat"><b>{s.value}</b><span>{soften(s.label)}</span></div>
			))}
		</section>
	)}
	{site.studio.client_logos.length > 0 ? (
		<section class="clients clients--logos" data-reveal>
			<span class="label">Seen at · Worked with</span>
			<div class="logowall">
				{site.studio.client_logos.map((c) => <img src={c.logo} alt={c.name} title={c.name} loading="lazy" />)}
			</div>
		</section>
	) : site.studio.clients.length > 0 && (
		<section class="clients" data-reveal>
			<span class="label">Seen at · Worked with</span>
			{site.studio.clients.map((c) => <span>{c}</span>)}
		</section>
	)}

	<CtaBand href="/enquire/" kicker="Get in touch" label="Let's <em>talk.</em>" />
</Base>
