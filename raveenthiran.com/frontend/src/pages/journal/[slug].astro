---
import Base from '../../layouts/Base.astro';
import { getPosts, getPost } from '../../lib/wp';
import { jsonForScript, cleanHtml } from '../../lib/safe';
import { soften } from '../../lib/format';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post, i) => ({
		params: { slug: post.slug },
		props: { next: posts[(i + 1) % posts.length] },
	}));
}

const { slug } = Astro.params;
const { next } = Astro.props;
const post = (await getPost(slug!))!;
const body = cleanHtml(post.content);

const siteBase = (Astro.site?.href || 'https://raveenthiran.com/').replace(/\/$/, '');
const abs = (u: string) => (/^https?:\/\//.test(u) ? u : siteBase + (u.startsWith('/') ? '' : '/') + u);
const articleLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	'@id': `${siteBase}/journal/${post.slug}/#article`,
	headline: post.title,
	description: post.excerpt,
	url: `${siteBase}/journal/${post.slug}/`,
	...(post.date ? { datePublished: post.date, dateModified: post.date } : {}),
	...(post.image ? { image: [abs(post.image)] } : {}),
	...(post.category ? { articleSection: post.category } : {}),
	author: { '@type': 'Person', name: 'Nishuthan Raveenthiran' },
	publisher: { '@type': 'Person', name: 'Nishuthan Raveenthiran' },
	inLanguage: 'en',
	mainEntityOfPage: `${siteBase}/journal/${post.slug}/`,
};
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteBase + '/' },
		{ '@type': 'ListItem', position: 2, name: 'Journal', item: siteBase + '/journal/' },
		{ '@type': 'ListItem', position: 3, name: post.title, item: `${siteBase}/journal/${post.slug}/` },
	],
};
---
<Base title={`${post.title} — Journal`} description={post.excerpt} active="journal" page="article" ogImage={post.image} preload={post.image} preloadSrcset={post.imageSrcset || ''} preloadSizes="(max-width: 900px) 100vw, 900px">
	<script type="application/ld+json" set:html={jsonForScript(articleLd)} is:inline />
	<script type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} is:inline />
	<article class="article">
		<header class="article__head">
			<p class="mono" data-intro><a href="/journal/">Journal</a> · {[soften(post.category), post.dateLabel].filter(Boolean).join(' · ')}</p>
			<h1 data-intro>{soften(post.title)}</h1>
		</header>
		{post.image && (
			<figure class="article__cover" data-reveal><img src={post.image} srcset={post.imageSrcset || undefined} sizes="(max-width: 900px) 100vw, 900px" width={post.imageW || undefined} height={post.imageH || undefined} alt={post.title} data-zoom loading="eager" fetchpriority="high" /></figure>
		)}
		<div class="article__body" data-reveal set:html={body} />
	</article>

	{next && next.slug !== post.slug && (
		<a class="next" href={`/journal/${next.slug}/`}>
			<span class="next__k mono"><span>Next entry</span><span>→</span></span>
			<span class="next__t">{soften(next.title)}</span>
		</a>
	)}
</Base>
