---
import Base from '../layouts/Base.astro';
---
<Base title="Offline — Raveenthiran" description="You are offline." page="offline">
	<section class="notfound">
		<div class="eyebrow" style="margin-bottom:20px">NO CONNECTION</div>
		<h1>OFFLINE.</h1>
		<p>This page isn't cached yet. Reconnect and try again — recently visited pages still work offline.</p>
		<div class="hero__cta">
			<a class="btn" href="/">Back home</a>
		</div>
	</section>
</Base>
