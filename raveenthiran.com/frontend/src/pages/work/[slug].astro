---
import Base from '../../layouts/Base.astro';
import { getProjects, getProject, getSite } from '../../lib/wp';
import { jsonForScript, safeUrl, cleanHtml } from '../../lib/safe';
import IndexRows from '../../components/ui/IndexRows.astro';
import { pad, soften } from '../../lib/format';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p, i) => {
		// Series are shown inside the post (no series pages): collect the other
		// projects that share a series with this one, for the FROM THE SERIES rows.
		const mine = new Set((p.series || []).map((s) => s.slug));
		const siblings = mine.size
			? projects
					.filter((q) => q.slug !== p.slug && (q.series || []).some((s) => mine.has(s.slug)))
					
			: [];
		return {
			params: { slug: p.slug },
			props: { index: i, total: projects.length, next: projects[(i + 1) % projects.length], nextIndex: (i + 1) % projects.length, siblings },
		};
	});
}

const { slug } = Astro.params;
const { index, total, next, nextIndex, siblings } = Astro.props;
const p = (await getProject(slug!))!;

const catLabel = soften(p.category || 'Work');

const meta = ([
	['Client', p.client],
	['Location', p.location],
	['Services', p.services.join(' · ')],
] as [string, string][]).filter(([, v]) => v);

// Booking bridge: the enquiry calculator opens on the session that matches this
// project's album (when the studio offers one) and carries the project along as
// the visual reference.
const site = await getSite();
const all = await getProjects();
const projects_index = (slug: string) => all.findIndex((q) => q.slug === slug) + 1;
const session = site.pricing.sessions.find((s) => p.category && s.name.toLowerCase().includes(p.category.toLowerCase()));
const bookHref = `/enquire/?${session ? `session=${encodeURIComponent(p.category.toLowerCase())}&` : ''}ref=${encodeURIComponent(p.slug)}`;
const bookLabel = session ? `Book a ${soften(p.category).toLowerCase()} session` : 'Start a commission';

// Frames: the cover first, then the gallery (without repeating the cover).
const cover = p.image ? [{ src: p.image, w: p.imageW || 0, h: p.imageH || 0, srcset: p.imageSrcset || '' }] : [];
const frames = [...cover, ...p.gallery.filter((g) => g.src !== p.image)];
const spec = [
	['Category', catLabel],
	['Year', p.year],
	['Location', p.location ? soften(p.location) : ''],
	['Frames', pad(frames.length)],
].filter(([, v]) => v);

// CMS values rendered into the page: links are scheme-checked, HTML is cleaned.
const website = safeUrl(p.website);
const body = cleanHtml(p.content);

// Share image: social scrapers do not render AVIF, so an AVIF og image gives
// way to the generated /og/<slug>.jpg card.
const isAvif = (u: string) => /\.avif(?:[?#]|$)/i.test(u || '');
const ogImage = p.ogImage && !isAvif(p.ogImage) ? p.ogImage : `/og/${p.slug}.jpg`;

// Unique, human meta description per project: prefer the statement text,
// otherwise compose one from the project's own metadata.
const plain = (p.content || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = plain.length > 40
	? (plain.length > 155 ? plain.slice(0, 152).replace(/\s+\S*$/, '') + '…' : plain)
	: `${p.category || 'Photography'}${p.location ? ` in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''} by Nishuthan Raveenthiran${p.services.length ? ` — ${p.services.join(', ')}` : ''}.`;

// Per-project structured data (image search + rich results).
const siteBase = (Astro.site?.href || 'https://raveenthiran.com/').replace(/\/$/, '');
const absImg = (u: string) => (/^https?:\/\//.test(u) ? u : siteBase + (u.startsWith('/') ? '' : '/') + u);
const projectImages = [p.image, ...p.gallery.map((g) => g.src)].filter(Boolean).map(absImg);
const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	'@id': `${siteBase}/work/${p.slug}/#project`,
	name: p.title,
	headline: p.title,
	description,
	url: `${siteBase}/work/${p.slug}/`,
	...(p.year ? { dateCreated: p.year } : {}),
	...(p.location ? { contentLocation: { '@type': 'Place', name: p.location } } : {}),
	...(p.category ? { genre: p.category } : {}),
	...(p.services.length ? { keywords: p.services.join(', ') } : {}),
	creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran', jobTitle: 'Photographer' },
	...(projectImages.length
		? {
				image: projectImages,
				associatedMedia: projectImages.map((u) => ({
					'@type': 'ImageObject',
					contentUrl: u,
					creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran' },
					creditText: 'Nishuthan Raveenthiran',
					copyrightNotice: `© ${new Date().getFullYear()} Nishuthan Raveenthiran`,
				})),
			}
		: {}),
};
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteBase + '/' },
		{ '@type': 'ListItem', position: 2, name: 'Work', item: siteBase + '/work/' },
		{ '@type': 'ListItem', position: 3, name: p.title, item: `${siteBase}/work/${p.slug}/` },
	],
};
---
<Base title={`${p.title} — Raveenthiran`} description={description} active="work" page="project" ogImage={ogImage} preload={p.image} preloadSrcset={p.imageSrcset || ''} preloadSizes="(max-width: 719px) 100vw, 50vw">
	<script type="application/ld+json" set:html={jsonForScript(projectLd)} is:inline />
	<script type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} is:inline />

	<nav class="p-top mono" aria-label="Breadcrumb" data-intro>
		<a href="/work/">← All work</a><span class="acc">{pad(index + 1, 3)} / {pad(total, 3)}</span>
	</nav>
	<h1 class="p-title" data-intro>{p.title}</h1>

	<dl class="cells p-spec mono" data-intro>
		{spec.map(([k, v]) => <div class="cell"><dt class="k">{k}</dt><dd class="v v--big" style="margin-left:0">{v}</dd></div>)}
	</dl>

	{body
		? <div class="p-text" set:html={body} />
		: <p class="p-text">{`${catLabel === 'Work' ? 'Photographed' : catLabel + ', photographed'}${p.location ? ` in ${soften(p.location)}` : ''}${p.year ? `, ${p.year}` : ''}.`}</p>}

	{frames.length > 0 && (
		<section class="frames proj-gallery" aria-label={`${p.title} — ${frames.length} frames`}>
			{frames.map((g, i) => (
				<figure class="frame">
					<img src={g.src} srcset={g.srcset || undefined} sizes={g.srcset ? '(max-width: 719px) 100vw, 50vw' : undefined} width={g.w || undefined} height={g.h || undefined}
						alt={`${p.title} — ${i + 1}`} data-zoom tabindex="0" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" transition:name={i === 0 ? `cover-${p.slug}` : undefined} />
					<figcaption aria-hidden="true">{pad(i + 1)}</figcaption>
				</figure>
			))}
		</section>
	)}

	<dl class="cells cells--wide mono">
		{meta.filter(([k]) => k !== 'Location').map(([k, v]) => <div class="cell"><dt class="k">{k}</dt><dd class="v" style="margin-left:0">{v}</dd></div>)}
		{(p.credits.length > 0 ? p.credits : [{ role: 'Photography', name: 'Nishuthan Raveenthiran', url: '' }]).map((c) => { const href = safeUrl(c.url); return (
			<div class="cell"><dt class="k">{soften(c.role)}</dt><dd class="v" style="margin-left:0">{href ? <a href={href} target="_blank" rel="noopener">{c.name}</a> : c.name}</dd></div>
		); })}
		{(p.series || []).length > 0 && (
			<div class="cell"><dt class="k">Series</dt><dd class="v" style="margin-left:0">{(p.series || []).map((s, i) => <>{i > 0 && ' · '}<a href={`/work/?series=${encodeURIComponent(s.slug)}`}>{soften(s.name)}</a></>)}</dd></div>
		)}
		{website && (
			<div class="cell"><dt class="k">Website</dt><dd class="v" style="margin-left:0"><a href={website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></dd></div>
		)}
	</dl>

	<!-- Booking bridge: the calculator opens with this project attached as reference -->
	<a class="book mono" href={bookHref}><span>Commission — frames like these</span><b>{bookLabel} →</b></a>

	{siblings.length > 0 && (
		<section aria-label="From the series">
			<p class="series-k mono">From the series — {(p.series || []).map((s) => soften(s.name)).join(' · ')}</p>
			<IndexRows rows={siblings.map((q) => ({ p: q, n: projects_index(q.slug) }))} />
		</section>
	)}

	{next && next.slug !== p.slug && (
		<a class="next" href={`/work/${next.slug}/`}>
			<span class="next__k mono"><span>Next — {pad(nextIndex + 1, 3)}</span><span aria-hidden="true">→</span></span>
			<span class="next__t">{next.title}</span>
		</a>
	)}
</Base>
