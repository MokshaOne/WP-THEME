---
import Base from '../../layouts/Base.astro';
import { getProjects, getProject, getSite } from '../../lib/wp';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p, i) => {
		// Series are shown inside the post (no series pages): collect the other
		// projects that share a series with this one, for the FROM THE SERIES rows.
		const mine = new Set((p.series || []).map((s) => s.slug));
		const siblings = mine.size
			? projects
					.filter((q) => q.slug !== p.slug && (q.series || []).some((s) => mine.has(s.slug)))
					.map((q) => ({ slug: q.slug, title: q.title, category: q.category, year: q.year, image: q.image }))
			: [];
		return {
			params: { slug: p.slug },
			props: { index: i, next: projects[(i + 1) % projects.length], siblings },
		};
	});
}

const { slug } = Astro.params;
const { index, next, siblings } = Astro.props;
const p = (await getProject(slug!))!;

const up = (s: string) => (s || '').toUpperCase();
const titleLines = up(p.title).split(/\s*—\s*|\s*·\s*/).filter(Boolean);
const eyebrow = `FIG. ${String(index + 1).padStart(3, '0')} — ${up(p.category || 'WORK')} — ${p.year}`;

const meta = ([
	['CLIENT', p.client],
	['LOCATION', p.location],
	['SERVICES', p.services.join(' · ')],
] as [string, string][]).filter(([, v]) => v);

// Booking bridge: the enquiry calculator opens on the session that matches this
// project's album (when the studio offers one) and carries the project along as
// the visual reference.
const site = await getSite();
const session = site.pricing.sessions.find((s) => p.category && s.name.toLowerCase().includes(p.category.toLowerCase()));
const bookHref = `/enquire/?${session ? `session=${encodeURIComponent(p.category.toLowerCase())}&` : ''}ref=${encodeURIComponent(p.slug)}`;
const bookLabel = session ? `BOOK A ${up(p.category)} SESSION` : 'START A COMMISSION';

const gallery = p.gallery.length ? p.gallery : [{ src: p.image, w: p.imageW || 0, h: p.imageH || 0 }];

// Unique, human meta description per project: prefer the statement text,
// otherwise compose one from the project's own metadata.
const plain = (p.content || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = plain.length > 40
	? (plain.length > 155 ? plain.slice(0, 152).replace(/\s+\S*$/, '') + '…' : plain)
	: `${p.category || 'Photography'}${p.location ? ` in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''} by Nishuthan Raveenthiran${p.services.length ? ` — ${p.services.join(', ')}` : ''}.`;

// Per-project structured data (image search + rich results).
const siteBase = (Astro.site?.href || 'https://raveenthiran.com/').replace(/\/$/, '');
const absImg = (u: string) => (/^https?:\/\//.test(u) ? u : siteBase + (u.startsWith('/') ? '' : '/') + u);
const projectImages = [p.image, ...p.gallery.map((g) => g.src)].filter(Boolean).map(absImg);
const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	'@id': `${siteBase}/work/${p.slug}/#project`,
	name: p.title,
	headline: p.title,
	description,
	url: `${siteBase}/work/${p.slug}/`,
	...(p.year ? { dateCreated: p.year } : {}),
	...(p.location ? { contentLocation: { '@type': 'Place', name: p.location } } : {}),
	...(p.category ? { genre: p.category } : {}),
	...(p.services.length ? { keywords: p.services.join(', ') } : {}),
	creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran', jobTitle: 'Photographer' },
	...(projectImages.length
		? {
				image: projectImages,
				associatedMedia: projectImages.map((u) => ({
					'@type': 'ImageObject',
					contentUrl: u,
					creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran' },
					creditText: 'Nishuthan Raveenthiran',
					copyrightNotice: `© ${new Date().getFullYear()} Nishuthan Raveenthiran`,
				})),
			}
		: {}),
};
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteBase + '/' },
		{ '@type': 'ListItem', position: 2, name: 'Work', item: siteBase + '/work/' },
		{ '@type': 'ListItem', position: 3, name: p.title, item: `${siteBase}/work/${p.slug}/` },
	],
};
---
<Base title={`${p.title} — Raveenthiran`} description={description} active="work" page="project" ogImage={p.ogImage || `/og/${p.slug}.jpg`} preload={p.image}>
	<script type="application/ld+json" set:html={JSON.stringify(projectLd)} is:inline />
	<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} is:inline />
	<!-- SPLIT HERO -->
	<section class="proj-hero">
		<div class="proj-hero__left">
			<div>
				<div class="eyebrow" data-intro style="margin-bottom:20px">{eyebrow}</div>
				<h1 class="proj-hero__title">
					{(titleLines.length ? titleLines : [up(p.title)]).map((l) => <span class="line" data-intro>{l}</span>)}
				</h1>
			</div>
			{meta.length > 0 && (
				<dl class="meta-row" data-intro>
					{meta.map(([k, v]) => <div><dt class="k">{k}</dt><dd>{v}</dd></div>)}
				</dl>
			)}
		</div>
		<div class="proj-hero__right" data-intro>
			<img src={p.image} srcset={p.imageSrcset || undefined} sizes="(max-width: 860px) 100vw, 42vw" width={p.imageW || undefined} height={p.imageH || undefined} alt={p.title} loading="eager" fetchpriority="high" transition:name={`cover-${p.slug}`} />
		</div>
	</section>

	<!-- GALLERY RAIL -->
	<section class="proj-gallery">
		<div class="rail" data-drag data-rail tabindex="0" aria-label={`${p.title} — gallery, ${gallery.length} frames`}>
			{gallery.map((g, i) => (
				<div class="card">
					<div class="plate"><img src={g.src} srcset={g.srcset || undefined} alt={`${p.title} — ${i + 1}`} data-zoom loading={i === 0 ? 'eager' : 'lazy'} /></div>
					<div class="cap"><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="c">/ {String(gallery.length).padStart(2, '0')}</span></div>
				</div>
			))}
		</div>
		<div class="rail-nav">
			<span class="rail-nav__hint">DRAG, SCROLL OR USE THE ARROWS — CLICK A FRAME TO OPEN IT</span>
			<div class="slide-nav" data-rail-nav>
				<button class="rbtn" data-rail-prev aria-label="Previous frame">←</button>
				<span class="slide-count"><span data-rail-count>01</span><span class="of"> / {String(gallery.length).padStart(2, '0')}</span></span>
				<button class="rbtn" data-rail-next aria-label="Next frame">→</button>
			</div>
		</div>
	</section>

	<!-- STATEMENT + CREDITS -->
	<section class="proj-statement" data-reveal>
		{p.content
			? <div set:html={p.content} />
			: <p>{`${p.category || 'A photographic'} series${p.location ? ` made in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''}.`}</p>}
		<div class="credits">
			{p.credits.length > 0
				? p.credits.map((c) => (<><span class="k">{up(c.role)}</span><span>{c.url ? <a href={c.url} target="_blank" rel="noopener">{c.name}</a> : c.name}</span></>))
				: (<><span class="k">PHOTOGRAPHY</span><span>NISHUTHAN RAVEENTHIRAN</span></>)}
			{(p.series || []).length > 0 && (
				<><span class="k">SERIES</span><span>{(p.series || []).map((s) => <a class="chipline" href={`/work/?series=${s.slug}`}>{up(s.name)}</a>)}</span></>
			)}
			{p.website && (
				<><span class="k">WEBSITE</span><span><a href={p.website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></span></>
			)}
		</div>
	</section>

	<!-- BOOKING BRIDGE — from looking to asking, with this project as the reference -->
	<section class="booklike" data-reveal>
		<div>
			<div class="sec__hint">COMMISSION</div>
			<p class="booklike__t">WANT FRAMES LIKE THESE?</p>
			<p class="booklike__p">The calculator opens with this project attached as your reference — you get an orientation figure now and a written offer within 24 hours.</p>
		</div>
		<a class="btn btn--solid" href={bookHref}>{bookLabel} →</a>
	</section>

	<!-- FROM THE SERIES — the other frames that belong to this series -->
	{siblings.length > 0 && (
		<section class="wrap" data-reveal style="padding:var(--sp-tight) var(--gx);border-bottom:var(--hair)">
			<div style="display:flex;justify-content:space-between;align-items:baseline;gap:24px;margin-bottom:28px">
				<div class="sec__hint" style="margin:0">FROM THE SERIES — {up((p.series || []).map((s) => s.name).join(' · '))}</div>
				<a class="chipline" href={`/work/?series=${(p.series || [])[0]?.slug || ''}`}>VIEW THE WHOLE SERIES →</a>
			</div>
			<div class="index">
				{siblings.map((s, i) => (
					<a class="index__row" href={`/work/${s.slug}/`} data-peek data-img={s.image}>
						<span class="k">{String(i + 1).padStart(3, '0')}</span>
						<span class="t">{up(s.title)}</span>
						<span class="k cat">{up(s.category)}</span>
						<span class="k year">{s.year}</span>
					</a>
				))}
			</div>
		</section>
	)}

	<!-- NEXT PROJECT -->
	{next && next.slug !== p.slug && (
		<a class="cta cta--sm" href={`/work/${next.slug}/`}>
			<span style="font-family:var(--font-body);font-size:11px;letter-spacing:0.22em;color:var(--faint)">NEXT PROJECT</span>
			<span>{up(next.title)} →</span>
		</a>
	)}
</Base>
