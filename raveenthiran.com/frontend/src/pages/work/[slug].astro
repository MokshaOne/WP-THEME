---
import Base from '../../layouts/Base.astro';
import { getProjects, getProject, getSite } from '../../lib/wp';
import { jsonForScript, safeUrl, cleanHtml } from '../../lib/safe';
import SectionHead from '../../components/ui/SectionHead.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { pad, soften } from '../../lib/format';

export async function getStaticPaths() {
	const projects = await getProjects();
	return projects.map((p, i) => {
		// Series are shown inside the post (no series pages): collect the other
		// projects that share a series with this one, for the FROM THE SERIES rows.
		const mine = new Set((p.series || []).map((s) => s.slug));
		const siblings = mine.size
			? projects
					.filter((q) => q.slug !== p.slug && (q.series || []).some((s) => mine.has(s.slug)))
					.map((q) => ({ slug: q.slug, title: q.title, category: q.category, year: q.year, image: q.image }))
			: [];
		return {
			params: { slug: p.slug },
			props: { index: i, next: projects[(i + 1) % projects.length], siblings },
		};
	});
}

const { slug } = Astro.params;
const { index, next, siblings } = Astro.props;
const p = (await getProject(slug!))!;

// Title split on em-dash / middot: first line upright, the rest set in italic.
const titleLines = soften(p.title).split(/\s*—\s*|\s*·\s*/).filter(Boolean);
const catLabel = soften(p.category || 'Work');
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const meta = ([
	['Client', p.client],
	['Location', p.location],
	['Services', p.services.join(' · ')],
] as [string, string][]).filter(([, v]) => v);

// Booking bridge: the enquiry calculator opens on the session that matches this
// project's album (when the studio offers one) and carries the project along as
// the visual reference.
const site = await getSite();
const session = site.pricing.sessions.find((s) => p.category && s.name.toLowerCase().includes(p.category.toLowerCase()));
const bookHref = `/enquire/?${session ? `session=${encodeURIComponent(p.category.toLowerCase())}&` : ''}ref=${encodeURIComponent(p.slug)}`;
const bookLabel = session ? `Book a ${soften(p.category).toLowerCase()} session` : 'Start a commission';

const gallery = p.gallery.length ? p.gallery : [{ src: p.image, w: p.imageW || 0, h: p.imageH || 0, srcset: p.imageSrcset || '' }];
// Gallery frames are 66vh tall with a natural width (theme.css .proj-gallery),
// so the rendered width is 66vh × aspect — telling the browser lets it pick the
// right srcset candidate instead of assuming 100vw.
const gallerySizes = (w: number, h: number) => (w && h ? `calc(66vh * ${(w / h).toFixed(3)})` : undefined);

// CMS values rendered into the page: links are scheme-checked, HTML is cleaned.
const website = safeUrl(p.website);
const body = cleanHtml(p.content);

// Share image: social scrapers do not render AVIF, so an AVIF og image gives
// way to the generated /og/<slug>.jpg card.
const isAvif = (u: string) => /\.avif(?:[?#]|$)/i.test(u || '');
const ogImage = p.ogImage && !isAvif(p.ogImage) ? p.ogImage : `/og/${p.slug}.jpg`;

// Unique, human meta description per project: prefer the statement text,
// otherwise compose one from the project's own metadata.
const plain = (p.content || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = plain.length > 40
	? (plain.length > 155 ? plain.slice(0, 152).replace(/\s+\S*$/, '') + '…' : plain)
	: `${p.category || 'Photography'}${p.location ? ` in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''} by Nishuthan Raveenthiran${p.services.length ? ` — ${p.services.join(', ')}` : ''}.`;

// Per-project structured data (image search + rich results).
const siteBase = (Astro.site?.href || 'https://raveenthiran.com/').replace(/\/$/, '');
const absImg = (u: string) => (/^https?:\/\//.test(u) ? u : siteBase + (u.startsWith('/') ? '' : '/') + u);
const projectImages = [p.image, ...p.gallery.map((g) => g.src)].filter(Boolean).map(absImg);
const projectLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	'@id': `${siteBase}/work/${p.slug}/#project`,
	name: p.title,
	headline: p.title,
	description,
	url: `${siteBase}/work/${p.slug}/`,
	...(p.year ? { dateCreated: p.year } : {}),
	...(p.location ? { contentLocation: { '@type': 'Place', name: p.location } } : {}),
	...(p.category ? { genre: p.category } : {}),
	...(p.services.length ? { keywords: p.services.join(', ') } : {}),
	creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran', jobTitle: 'Photographer' },
	...(projectImages.length
		? {
				image: projectImages,
				associatedMedia: projectImages.map((u) => ({
					'@type': 'ImageObject',
					contentUrl: u,
					creator: { '@type': 'Person', name: 'Nishuthan Raveenthiran' },
					creditText: 'Nishuthan Raveenthiran',
					copyrightNotice: `© ${new Date().getFullYear()} Nishuthan Raveenthiran`,
				})),
			}
		: {}),
};
const breadcrumbLd = {
	'@context': 'https://schema.org',
	'@type': 'BreadcrumbList',
	itemListElement: [
		{ '@type': 'ListItem', position: 1, name: 'Home', item: siteBase + '/' },
		{ '@type': 'ListItem', position: 2, name: 'Work', item: siteBase + '/work/' },
		{ '@type': 'ListItem', position: 3, name: p.title, item: `${siteBase}/work/${p.slug}/` },
	],
};
---
<Base title={`${p.title} — Raveenthiran`} description={description} active="work" page="project" ogImage={ogImage} preload={p.image} preloadSrcset={p.imageSrcset || ''} preloadSizes="(max-width: 860px) 100vw, 42vw">
	<script type="application/ld+json" set:html={jsonForScript(projectLd)} is:inline />
	<script type="application/ld+json" set:html={jsonForScript(breadcrumbLd)} is:inline />
	<!-- HERO — title + facts left, cover right -->
	<section class="proj-hero">
		<div class="proj-hero__left">
			<div>
				<nav class="proj-hero__crumb label" aria-label="Breadcrumb" data-intro>
					<a href="/work/">Work</a><span aria-hidden="true">/</span>
					<a href={`/work/?cat=${encodeURIComponent((p.category || '').toLowerCase())}`}>{catLabel}</a>
					{p.year && <><span aria-hidden="true">/</span><span>{p.year}</span></>}
					<span class="proj-hero__no" aria-hidden="true">No. {pad(index + 1, 3)}</span>
				</nav>
				<h1 class="proj-hero__title">
					{(titleLines.length ? titleLines : [p.title]).map((l) => <span class="line" data-intro>{l}</span>)}
				</h1>
			</div>
			{meta.length > 0 && (
				<dl class="meta-row" data-intro>
					{meta.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
				</dl>
			)}
		</div>
		<div class="proj-hero__right" data-intro>
			<img src={p.image} srcset={p.imageSrcset || undefined} sizes="(max-width: 860px) 100vw, 42vw" width={p.imageW || undefined} height={p.imageH || undefined} alt={p.title} loading="eager" fetchpriority="high" transition:name={`cover-${p.slug}`} />
		</div>
	</section>

	<!-- GALLERY RAIL -->
	<section class="proj-gallery" aria-label="Gallery">
		<div class="rail" data-drag data-rail tabindex="0" aria-label={`${p.title} — gallery, ${gallery.length} frames`}>
			{gallery.map((g, i) => (
				<figure class="card">
					<div class="plate"><img src={g.src} srcset={g.srcset || undefined} sizes={g.srcset ? gallerySizes(g.w, g.h) : undefined} width={g.w || undefined} height={g.h || undefined} alt={`${p.title} — ${i + 1}`} data-zoom loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
					<figcaption class="cap"><span class="n">{pad(i + 1)}</span><span>/ {pad(gallery.length)}</span></figcaption>
				</figure>
			))}
		</div>
		<div class="rail-nav">
			<span class="rail-nav__hint">Drag, scroll or use the arrows — click a frame to open it.</span>
			<div class="slide-nav" data-rail-nav>
				<button class="rbtn" data-rail-prev aria-label="Previous frame">←</button>
				<span class="slide-count"><span data-rail-count>01</span><span class="of"> / {pad(gallery.length)}</span></span>
				<button class="rbtn" data-rail-next aria-label="Next frame">→</button>
			</div>
		</div>
	</section>

	<!-- STATEMENT + CREDITS -->
	<section class="proj-statement" data-reveal>
		<div>
			<p class="label proj-statement__kicker">About the project</p>
			{body
				? <div class="proj-statement__body" set:html={body} />
				: <div class="proj-statement__body"><p>{`${catLabel === 'Work' ? 'A photographic' : catLabel} series${p.location ? ` made in ${p.location}` : ''}${p.year ? `, ${p.year}` : ''}.`}</p></div>}
		</div>
		<div class="credits">
			{p.credits.length > 0
				? p.credits.map((c) => { const href = safeUrl(c.url); return (<><span class="k">{soften(c.role)}</span><span>{href ? <a href={href} target="_blank" rel="noopener">{c.name}</a> : c.name}</span></>); })
				: (<><span class="k">Photography</span><span>Nishuthan Raveenthiran</span></>)}
			{(p.series || []).length > 0 && (
				<><span class="k">Series</span><span class="tags">{(p.series || []).map((s) => <a class="tag" href={`/work/?series=${encodeURIComponent(s.slug)}`}>{soften(s.name)}</a>)}</span></>
			)}
			{website && (
				<><span class="k">Website</span><span><a href={website} target="_blank" rel="noopener">{p.website.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></span></>
			)}
		</div>
	</section>

	<!-- BOOKING BRIDGE — from looking to asking, with this project as the reference -->
	<section class="booklike" data-reveal>
		<div>
			<p class="label">Commission</p>
			<p class="booklike__t">Want frames <em>like these?</em></p>
			<p class="booklike__p">The calculator opens with this project attached as your reference — you get an orientation figure now and a written offer within 24 hours.</p>
		</div>
		<a class="btn btn--solid" href={bookHref}>{bookLabel} <span class="arr" aria-hidden="true">→</span></a>
	</section>

	<!-- FROM THE SERIES — the other frames that belong to this series -->
	{siblings.length > 0 && (
		<section class="series">
			<SectionHead kicker={`From the series — ${(p.series || []).map((s) => soften(s.name)).join(' · ')}`}
				href={`/work/?series=${encodeURIComponent((p.series || [])[0]?.slug || '')}`} linkLabel="View the whole series" />
			<div class="index" data-reveal>
				{siblings.map((s, i) => (
					<a class="index__row" href={`/work/${s.slug}/`} data-peek data-img={s.image}>
						<span class="k">{pad(i + 1, 3)}</span>
						<span class="t">{s.title}</span>
						<span class="k cat">{soften(s.category)}</span>
						<span class="k year">{s.year}</span>
					</a>
				))}
			</div>
		</section>
	)}

	<!-- NEXT PROJECT -->
	{next && next.slug !== p.slug && (
		<CtaBand href={`/work/${next.slug}/`} kicker="Next project" label={`${esc(next.title)}`} variant="next" />
	)}
</Base>
