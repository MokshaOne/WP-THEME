---
import Base from '../../layouts/Base.astro';
import PageIntro from '../../components/ui/PageIntro.astro';
import ProjectCard from '../../components/ui/ProjectCard.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import { getProjects } from '../../lib/wp';
import { pad } from '../../lib/format';

const projects = await getProjects();
// data-cat stays upper-case: the URL filter in ui.js compares against category.toUpperCase()
const up = (s: string) => (s || '').toUpperCase();
const years = projects.map((p) => +p.year).filter(Boolean);
const from = years.length ? Math.min(...years) : 2020;
const to = years.length ? Math.max(...years) : new Date().getFullYear();
// Asymmetric grid, repeating 65% left / 45% right (overlapping) / 70% centred.
const sizesFor = (i: number) => ['(max-width: 900px) 100vw, 65vw', '(max-width: 900px) 86vw, 45vw', '(max-width: 900px) 100vw, 70vw'][i % 3];
---
<Base title="The Work — Raveenthiran" description="The full archive — portrait, fashion and editorial work from Vienna and across Austria." active="work" page="work">
	<PageIntro kicker="" title="<em>Work.</em>">
		<span slot="kicker">{from}–{to} · <span data-count>{pad(projects.length)}</span> projects</span>
	</PageIntro>

	<section class="wgrid" data-work-grid aria-label="Projects">
		{projects.map((p, i) => (
			<ProjectCard project={p} index={i + 1} sizes={sizesFor(i)} eager={i < 2}
				data-cat={up(p.category)}
				data-series={(p.series || []).map((s) => s.slug).join(' ')}
				data-series-name={(p.series || []).map((s) => s.name).join(' · ')} />
		))}
	</section>

	<CtaBand href="/enquire/" kicker="Book a session" label="Your session is <em>next.</em>" />
</Base>
