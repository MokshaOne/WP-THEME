---
// Work — the archive: WORK + count, category chips, Index / Grid view (S/M/L).
// Index rows float a cursor preview; grid tiles go from mono to colour.
// /work/?cat=<cat> and ?series=<slug> deep links still narrow the list (ui.js).
import Base from '../../layouts/Base.astro';
import IndexRows from '../../components/ui/IndexRows.astro';
import { getProjects } from '../../lib/wp';
import { pad, soften } from '../../lib/format';

const projects = await getProjects();
const up = (s: string) => (s || '').toUpperCase();
const cats = [...new Set(projects.map((p) => p.category).filter(Boolean))];
const count = (c: string) => projects.filter((p) => p.category === c).length;
const attrs = (p: (typeof projects)[number]) => ({ 'data-cat': up(p.category), 'data-series': (p.series || []).map((s) => s.slug).join(' ') });
---
<Base title="The Work — Raveenthiran" description="The full archive — portrait, fashion and editorial work from Vienna and across Austria." active="work" page="work">
	<section data-work data-view="index" data-size="M">
		<div class="w-head">
			<h1 class="ptitle" data-intro>Work<sup data-count>{pad(projects.length, 3)}</sup></h1>
			<div class="w-ctrl" data-intro>
				<div class="chips" role="group" aria-label="Filter by category">
					<button class="btn-b" type="button" data-filter="" aria-pressed="true">All <span>{pad(projects.length)}</span></button>
					{cats.map((c) => <button class="btn-b" type="button" data-filter={up(c)} aria-pressed="false">{soften(c)} <span>{pad(count(c))}</span></button>)}
				</div>
				<div class="view mono" role="group" aria-label="View">
					<span class="mute">View</span>
					<button class="btn-b" type="button" data-view-btn="index" aria-pressed="true">Index</button>
					<button class="btn-b" type="button" data-view-btn="grid" aria-pressed="false">Grid</button>
					<span class="sizes" role="group" aria-label="Tile size">
						{['S', 'M', 'L'].map((z) => <button class="btn-b" type="button" data-size-btn={z} aria-pressed={z === 'M' ? 'true' : 'false'}>{z}</button>)}
					</span>
				</div>
			</div>
		</div>

		<div class="ln-t">
			<IndexRows variant="work" rows={projects.map((p, i) => ({ p, n: i + 1, attrs: attrs(p) }))} />
		</div>

		<div class="wgrid" data-work-grid aria-label="Projects">
			{projects.map((p, i) => (
				<a class="tile card" href={`/work/${p.slug}/`} {...attrs(p)}>
					{p.image && <img src={p.image} srcset={p.imageSrcset || undefined} sizes="(max-width: 719px) 50vw, 25vw" width={p.imageW || undefined} height={p.imageH || undefined}
						alt={p.title} style={p.focal ? `--focal:${p.focal}` : undefined} loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />}
					<span class="tile__n" aria-hidden="true">{pad(i + 1, 3)}</span>
					<span class="tile__m"><span>{p.title}</span><span>{p.year}</span></span>
				</a>
			))}
		</div>
	</section>
</Base>
